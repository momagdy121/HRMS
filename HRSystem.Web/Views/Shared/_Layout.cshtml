@{
    var hideShell = ViewBag.HideShell as bool? ?? false;
    var role = ViewBag.Role as string ?? "HR";
    var activePage = ViewBag.ActivePage as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "HRMS Portal")</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CDN with Design Tokens -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#00375e",
                        "primary-container": "#1f4e79",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#95bff1",
                        "on-primary-fixed": "#001d35",
                        "on-primary-fixed-variant": "#184974",
                        "primary-fixed": "#d1e4ff",
                        "primary-fixed-dim": "#a0cafc",
                        "inverse-primary": "#a0cafc",
                        "secondary": "#505f76",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#d0e1fb",
                        "on-secondary-container": "#54647a",
                        "on-secondary-fixed": "#0b1c30",
                        "on-secondary-fixed-variant": "#38485d",
                        "secondary-fixed": "#d3e4fe",
                        "secondary-fixed-dim": "#b7c8e1",
                        "tertiary": "#323537",
                        "on-tertiary": "#ffffff",
                        "tertiary-container": "#494c4e",
                        "on-tertiary-container": "#babcbe",
                        "on-tertiary-fixed": "#191c1e",
                        "on-tertiary-fixed-variant": "#444749",
                        "tertiary-fixed": "#e0e3e5",
                        "tertiary-fixed-dim": "#c4c7c9",
                        "error": "#ba1a1a",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a",
                        "background": "#f9f9fd",
                        "on-background": "#1a1c1f",
                        "surface": "#f9f9fd",
                        "surface-bright": "#f9f9fd",
                        "surface-dim": "#d9dade",
                        "surface-container": "#ededf2",
                        "surface-container-low": "#f3f3f7",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-high": "#e8e8ec",
                        "surface-container-highest": "#e2e2e6",
                        "surface-variant": "#e2e2e6",
                        "surface-tint": "#35618d",
                        "on-surface": "#1a1c1f",
                        "on-surface-variant": "#42474f",
                        "outline": "#72777f",
                        "outline-variant": "#c2c7d0",
                        "inverse-surface": "#2f3034",
                        "inverse-on-surface": "#f0f0f4"
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.5rem",
                        full: "0.75rem"
                    },
                    spacing: {
                        xs: "4px",
                        sm: "8px",
                        md: "16px",
                        lg: "24px",
                        xl: "32px",
                        base: "4px",
                        "sidebar-width": "260px",
                        "sidebar-collapsed": "72px",
                        "navbar-height": "64px"
                    },
                    fontFamily: {
                        "h1": ["Inter"],
                        "h2": ["Inter"],
                        "h3": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "body-sm": ["Inter"],
                        "label-bold": ["Inter"],
                        "badge": ["Inter"]
                    },
                    fontSize: {
                        "h1": ["30px", { lineHeight: "38px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "h2": ["24px", { lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "600" }],
                        "h3": ["20px", { lineHeight: "28px", fontWeight: "600" }],
                        "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
                        "body-sm": ["13px", { lineHeight: "18px", fontWeight: "400" }],
                        "label-bold": ["12px", { lineHeight: "16px", fontWeight: "600" }],
                        "badge": ["12px", { lineHeight: "12px", fontWeight: "500" }]
                    }
                }
            }
        }
    </script>

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="@(hideShell ? "bg-background min-h-screen flex items-center justify-center p-md font-body-md text-on-surface" : "bg-background text-on-background font-body-md min-h-screen flex")">

@if (hideShell)
{
    @if (TempData["Error"] is string shellError)
    {
        <div class="fixed top-4 left-1/2 z-50 w-full max-w-md -translate-x-1/2 rounded-lg border border-error/30 bg-error-container px-4 py-3 text-on-error-container shadow-lg" role="alert">
            @shellError
        </div>
    }
    @RenderBody()
}
else
{
    <!-- Sidebar -->
    @if (role == "HR")
    {
        await Html.RenderPartialAsync("_Sidebar_HR");
    }
    else if (role == "DeptHead")
    {
        await Html.RenderPartialAsync("_Sidebar_DeptHead");
    }
    else
    {
        await Html.RenderPartialAsync("_Sidebar_Employee");
    }

    <!-- Main Content Wrapper -->
    <div class="flex-1 flex flex-col md:ml-[260px] w-full min-w-0">
        <!-- Top Navbar -->
        @await Html.PartialAsync("_TopNavbar")

        <!-- Page Content -->
        <main class="flex-1 overflow-y-auto bg-surface p-4 md:p-8">
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="mb-4 rounded-lg border border-error/30 bg-error-container px-4 py-3 text-on-error-container" role="alert">
                    @errorMessage
                </div>
            }
            @RenderBody()
        </main>
    </div>
}

@RenderSection("Modals", required: false)

<!-- Site JS -->
<script src="~/js/site.js"></script>
@RenderSection("Scripts", required: false)

</body>
</html>
