@{
    var userName = ViewBag.UserName as string ?? "User";
    var userTitle = ViewBag.UserTitle as string ?? "";
    var userAvatar = ViewBag.UserAvatar as string ?? "";
    var searchPlaceholder = ViewBag.SearchPlaceholder as string ?? "Search...";
}
<header class="bg-white/80 backdrop-blur-md border-b border-slate-200 shadow-sm sticky top-0 w-full z-40 flex justify-between items-center px-8 py-3">
    <div class="flex items-center gap-4">
        <button onclick="toggleSidebar()" class="md:hidden text-slate-500 hover:text-slate-700">
            <span class="material-symbols-outlined text-2xl">menu</span>
        </button>
        <div class="text-lg font-bold text-slate-900 lg:hidden">HRMS Portal</div>
        <div class="hidden md:flex relative w-64 lg:w-96">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">search</span>
            <input type="text" placeholder="@searchPlaceholder"
                   class="w-full pl-10 pr-4 py-2 bg-slate-100 border-transparent rounded-lg focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition-all font-body-sm text-on-surface" />
        </div>
    </div>
        <div class="flex items-center gap-2 lg:gap-4">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="p-2 text-slate-500 hover:bg-slate-50 rounded-lg hover:scale-105 transition-transform duration-150" title="Sign out">
                    <span class="material-symbols-outlined">logout</span>
                </button>
            </form>
        }
        <button class="p-2 text-slate-500 hover:bg-slate-50 rounded-lg hover:scale-105 transition-transform duration-150 relative">
            <span class="material-symbols-outlined">notifications</span>
            <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full"></span>
        </button>
        <button class="p-2 text-slate-500 hover:bg-slate-50 rounded-lg hover:scale-105 transition-transform duration-150 hidden sm:block">
            <span class="material-symbols-outlined">help</span>
        </button>
        <button class="p-2 text-slate-500 hover:bg-slate-50 rounded-lg hover:scale-105 transition-transform duration-150 hidden sm:block">
            <span class="material-symbols-outlined">apps</span>
        </button>
        <div class="h-6 w-px bg-slate-200 mx-2 hidden sm:block"></div>
        <div class="flex items-center gap-3 pl-2 pr-1 py-1 rounded-lg hover:bg-slate-50 transition-colors cursor-pointer">
            <div class="text-right hidden sm:block">
                <p class="text-sm font-semibold text-slate-700 font-label-bold">@userName</p>
                <p class="text-xs text-slate-500 font-body-sm">@userTitle</p>
            </div>
            @if (!string.IsNullOrEmpty(userAvatar))
            {
                <img alt="@userName" src="@userAvatar" class="w-8 h-8 rounded-full border border-slate-200 object-cover" />
            }
            else
            {
                <div class="w-8 h-8 rounded-full bg-primary-container text-white flex items-center justify-center font-label-bold text-xs">
                    @(userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : userName.ToUpper())
                </div>
            }
        </div>
    </div>
</header>
