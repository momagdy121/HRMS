@model string
@using Microsoft.AspNetCore.Mvc.ModelBinding
@{
    var prefix = Model;
    var errors = ViewContext.ViewData.ModelState
        .Where(kvp => kvp.Key.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        .SelectMany(kvp => kvp.Value?.Errors ?? Enumerable.Empty<ModelError>())
        .Select(e => e.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToList();
}

@if (errors.Count > 0)
{
    <div class="bg-error-container text-on-error-container font-body-sm p-sm rounded-lg border border-error mb-md" role="alert">
        <ul class="space-y-1">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}
