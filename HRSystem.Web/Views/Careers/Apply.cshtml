@model HRSystem.Web.ViewModels.Recruitment.ApplyJobViewModel
@{
    Layout = "_Layout";
}

<div class="min-h-screen bg-slate-50 flex flex-col font-['Inter']">
    <!-- Header -->
    <header class="bg-[#1f4e79] text-white py-6 px-4 sm:px-6 lg:px-8 border-b border-slate-700/40 shadow-sm">
        <div class="max-w-3xl mx-auto flex items-center justify-between">
            <a asp-action="Detail" asp-route-id="@Model.JobPostingId" class="inline-flex items-center gap-2 text-slate-300 hover:text-white transition text-sm font-semibold">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Back to Job Details
            </a>
            <div class="text-xs text-sky-200">HRMS Careers</div>
        </div>
    </header>

    <main class="flex-1 max-w-3xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <!-- Application Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm">
            <div class="border-b border-slate-100 pb-6 mb-6">
                <span class="px-2.5 py-0.5 rounded-md bg-sky-50 text-sky-700 font-semibold text-xs border border-sky-100 inline-block mb-2">
                    @Model.DepartmentName
                </span>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                    Application Form: @Model.JobTitle
                </h1>
                <p class="text-slate-500 text-xs mt-1">
                    Application deadline: @Model.ClosingDate.ToString("MMMM dd, yyyy")
                </p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
                    <div class="font-bold flex items-center gap-2 mb-1">
                        <span class="material-symbols-outlined text-rose-600 text-sm">warning</span>
                        Submission Notice
                    </div>
                    <ul class="list-disc pl-5 space-y-1">
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Apply" asp-route-id="@Model.JobPostingId" method="post" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="JobPostingId" />

                <!-- Candidate Full Name -->
                <div>
                    <label asp-for="FullName" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                    <input asp-for="FullName" placeholder="e.g. Jane Doe"
                           class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent text-sm transition" />
                    <span asp-validation-for="FullName" class="text-rose-600 text-xs mt-1 block"></span>
                </div>

                <!-- Contact Info Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Email" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                        <input asp-for="Email" type="email" placeholder="jane.doe@example.com"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent text-sm transition" />
                        <span asp-validation-for="Email" class="text-rose-600 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="PhoneNumber" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                        <input asp-for="PhoneNumber" placeholder="+1 (555) 000-0000"
                               class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent text-sm transition" />
                        <span asp-validation-for="PhoneNumber" class="text-rose-600 text-xs mt-1 block"></span>
                    </div>
                </div>

                <!-- CV Upload Box -->
                <div>
                    <label asp-for="CvFile" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                    <div class="border-2 border-dashed border-slate-300 hover:border-[#1f4e79] rounded-xl p-6 text-center bg-slate-50/50 transition">
                        <span class="material-symbols-outlined text-3xl text-slate-400 mb-2">upload_file</span>
                        <div class="text-sm font-medium text-slate-700">
                            Upload your CV or Resume
                        </div>
                        <p class="text-xs text-slate-500 mt-1 mb-3">
                            Supported formats: PDF, DOC, DOCX. Maximum file size: 5 MB.
                        </p>
                        <input asp-for="CvFile" type="file" accept=".pdf,.doc,.docx"
                               class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#1f4e79] file:text-white hover:file:bg-[#163a5b] file:cursor-pointer" />
                    </div>
                    <span asp-validation-for="CvFile" class="text-rose-600 text-xs mt-1 block"></span>
                </div>

                <!-- Cover Letter -->
                <div>
                    <label asp-for="CoverLetter" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                    <textarea asp-for="CoverLetter" rows="5" placeholder="Share why you are excited about this opportunity and why you are a great match..."
                              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent text-sm transition leading-relaxed"></textarea>
                    <span asp-validation-for="CoverLetter" class="text-rose-600 text-xs mt-1 block"></span>
                </div>

                <!-- Notice -->
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-500 leading-relaxed">
                    By submitting this application, you acknowledge that your submitted contact details and CV document will be securely reviewed by our recruitment team for evaluating your candidacy.
                </div>

                <!-- Submit Button -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                    <a asp-action="Detail" asp-route-id="@Model.JobPostingId"
                       class="px-5 py-2.5 rounded-lg border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-8 py-2.5 rounded-lg bg-[#1f4e79] hover:bg-[#163a5b] text-white font-bold text-sm shadow-md transition flex items-center gap-2">
                        Submit Application
                        <span class="material-symbols-outlined text-sm">send</span>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <footer class="bg-white border-t border-slate-200 py-6 px-4 text-center text-xs text-slate-500 mt-auto">
        <p>&copy; @DateTime.UtcNow.Year HRMS Portal. All rights reserved.</p>
    </footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
