@model ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password - HRMS Portal";
    var invalidToken = ViewBag.InvalidToken as bool? ?? false;
}

<div class="w-full max-w-md">
    <div class="text-center mb-lg">
        <h1 class="font-h1 text-h1 text-primary-container mb-xs">HRMS Portal</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">Management Console</p>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant p-xl">
        <div class="mb-lg">
            <h2 class="font-h2 text-h2 text-on-surface mb-xs">Reset Password</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">Enter your new password.</p>
        </div>

        @if (invalidToken)
        {
            <div class="mb-lg p-md bg-error-container border border-error/20 rounded-lg flex gap-md items-start">
                <span class="material-symbols-outlined text-error mt-0.5">error</span>
                <p class="font-body-sm text-body-sm text-on-error-container">The reset token is invalid or has expired. Please request a new reset link.</p>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="mb-lg p-md bg-error-container border border-error/20 rounded-lg font-body-sm text-body-sm text-on-error-container"></div>

        <form asp-action="ResetPassword" method="post" class="space-y-md">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />

            <div>
                <label asp-for="Email" class="block font-label-bold text-label-bold text-on-surface-variant mb-xs"></label>
                <input asp-for="Email"
                       class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-3 font-body-md text-body-md text-on-surface-variant"
                       readonly />
                <span asp-validation-for="Email" class="text-error font-body-sm"></span>
            </div>
            <div>
                <label asp-for="NewPassword" class="block font-label-bold text-label-bold text-on-surface-variant mb-xs"></label>
                <input asp-for="NewPassword"
                       class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-md py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-colors"
                       placeholder="••••••••" />
                <span asp-validation-for="NewPassword" class="text-error font-body-sm"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="block font-label-bold text-label-bold text-on-surface-variant mb-xs"></label>
                <input asp-for="ConfirmPassword"
                       class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-md py-3 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-colors"
                       placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-error font-body-sm"></span>
            </div>
            <div class="pt-sm">
                <button class="w-full bg-primary-container hover:bg-primary text-on-primary font-label-bold text-label-bold py-3 px-lg rounded-lg transition-colors flex justify-center items-center gap-xs shadow-sm" type="submit">
                    <span>Reset Password</span>
                    <span class="material-symbols-outlined text-[18px]">lock_reset</span>
                </button>
            </div>
        </form>
        <div class="mt-lg text-center">
            <a class="inline-flex items-center gap-xs font-body-sm text-body-sm text-primary-container hover:text-primary transition-colors group" asp-action="Login">
                <span class="material-symbols-outlined text-[16px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
                Back to Sign in
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
