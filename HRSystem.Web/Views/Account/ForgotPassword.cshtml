@{
    ViewBag.Title = "Forgot Password - HRMS Portal";
}

<main class="w-full max-w-[440px] bg-surface-container-lowest rounded-xl p-xl shadow-[0_2px_8px_rgba(0,0,0,0.04)] flex flex-col gap-lg border border-outline-variant/30">
    <div class="flex flex-col items-center gap-sm mb-sm text-center">
        <div class="flex items-center gap-sm text-primary-container mb-md">
            <span class="material-symbols-outlined text-[32px] block" style="font-variation-settings: 'FILL' 1;">domain</span>
            <span class="font-h3 text-h3 tracking-tight">HRMS Portal</span>
        </div>
        <h1 class="font-h2 text-h2 text-on-surface">Forgot Password</h1>
        <p class="font-body-md text-body-md text-on-surface-variant">Enter your email and we'll send you a reset link.</p>
    </div>
    <form class="flex flex-col gap-md w-full">
        <div class="flex flex-col gap-xs">
            <label class="font-label-bold text-label-bold text-on-surface" for="email">Email Address</label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-outline text-[20px]">mail</span>
                <input class="w-full pl-[36px] pr-sm py-[10px] bg-surface-bright border border-outline-variant rounded-DEFAULT font-body-md text-body-md text-on-surface focus:border-primary-container focus:ring-1 focus:ring-primary-container outline-none transition-colors"
                       id="email" placeholder="name@company.com" type="email" />
            </div>
        </div>
        <button class="w-full bg-primary-container text-on-primary font-label-bold text-label-bold py-[12px] rounded-lg hover:bg-primary transition-colors flex justify-center items-center shadow-sm" type="button">
            Send Reset Link
        </button>
    </form>
    <!-- Success State (Demo) -->
    <div class="bg-secondary-container/30 border border-secondary-container rounded-lg p-md flex flex-col gap-md">
        <div class="flex gap-sm items-start">
            <span class="material-symbols-outlined text-primary-container text-[20px] mt-[2px]" style="font-variation-settings: 'FILL' 1;">info</span>
            <p class="font-body-sm text-body-sm text-on-surface">
                A password reset link has been generated. In a production environment, this would be emailed to you. For this demo, use the link below:
            </p>
        </div>
        <div class="bg-surface-container-high rounded p-sm border border-outline-variant/50 overflow-x-auto">
            <code class="font-mono text-[12px] text-on-surface-variant break-all whitespace-pre-wrap">/Account/ResetPassword?email=user@company.com&amp;token=e9b4a8c2f1d6</code>
        </div>
    </div>
    <div class="text-center mt-sm">
        <a class="font-body-sm text-body-sm text-primary-container hover:text-primary font-medium hover:underline transition-colors" asp-action="Login">
            Remember your password? Sign in.
        </a>
    </div>
</main>
