@model ChangePasswordViewModel
@{
    var isRequired = ViewBag.IsRequired as bool? ?? false;
    ViewBag.Title = "Change Password - HRMS Portal";
}

<div class="w-full max-w-[440px] bg-surface-container-lowest rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-variant p-xl flex flex-col gap-lg backdrop-blur-[4px]">
    <div class="flex flex-col items-center gap-sm text-center">
        <div class="w-16 h-16 rounded-full bg-primary-container flex items-center justify-center mb-sm">
            <span class="material-symbols-outlined text-on-primary text-[32px]" style="font-variation-settings: 'FILL' 1;">lock_reset</span>
        </div>
        <h1 class="font-h1 text-h1 text-primary-container">Change Password</h1>
        <p class="font-body-md text-body-md text-on-surface-variant">
            @(isRequired ? "You must set a new password before continuing." : "Update your account password.")
        </p>
    </div>

    <form asp-action="ChangePassword" method="post" class="flex flex-col gap-md">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="bg-error-container text-on-error-container font-body-sm text-body-sm p-sm rounded-lg flex flex-col gap-xs border border-error"></div>

        <div class="flex flex-col gap-xs">
            <label asp-for="NewPassword" class="font-label-bold text-label-bold text-on-surface-variant"></label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-outline">lock</span>
                <input asp-for="NewPassword" class="w-full bg-surface-container-low border border-outline-variant rounded-lg py-sm pl-xl pr-sm font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-colors" />
            </div>
            <span asp-validation-for="NewPassword" class="text-error font-body-sm"></span>
        </div>

        <div class="flex flex-col gap-xs">
            <label asp-for="ConfirmPassword" class="font-label-bold text-label-bold text-on-surface-variant"></label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-outline">lock</span>
                <input asp-for="ConfirmPassword" class="w-full bg-surface-container-low border border-outline-variant rounded-lg py-sm pl-xl pr-sm font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-colors" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-error font-body-sm"></span>
        </div>

        <button class="mt-sm w-full bg-primary-container text-on-primary font-label-bold text-label-bold py-md rounded-lg hover:bg-primary transition-colors flex justify-center items-center gap-sm shadow-sm" type="submit">
            Update Password
            <span class="material-symbols-outlined text-[18px]">check</span>
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
