<select class="form-select border-slate-200 rounded-lg text-sm font-body-md focus:border-primary focus:ring-0">
<option>All Departments</option>
<option>Engineering</option>
<option>Human Resources</option>
<option>Marketing</option>
<option>Sales</option>
</select>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Month</label>
<select class="form-select border-slate-200 rounded-lg text-sm font-body-md focus:border-primary focus:ring-0">
<option>October</option>
<option>September</option>
<option>August</option>
</select>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Year</label>
<select class="form-select border-slate-200 rounded-lg text-sm font-body-md focus:border-primary focus:ring-0">
<option>2025</option>
<option>2024</option>
</select>
</div>
<div class="flex flex-col gap-1.5">
<label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Status</label>
<select class="form-select border-slate-200 rounded-lg text-sm font-body-md focus:border-primary focus:ring-0">
<option>All Statuses</option>
<option>Draft</option>
<option>Approved</option>
<option>Paid</option>
</select>
</div>
</div>
