</div>
<span class="font-semibold text-primary">Jane Smith</span>
</div>
</td>
<td class="px-6 py-4">Oct 2025</td>
<td class="px-6 py-4">$8,000</td>
<td class="px-6 py-4 text-green-600">+$1,000</td>
<td class="px-6 py-4 text-error">-$300</td>
