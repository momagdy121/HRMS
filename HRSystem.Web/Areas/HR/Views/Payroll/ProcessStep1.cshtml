<div class="flex items-center gap-2">
<button class="p-2 border border-slate-200 rounded-lg hover:bg-white text-secondary disabled:opacity-50" disabled="">
<span class="material-symbols-outlined text-[20px]" data-icon="chevron_left">chevron_left</span>
</button>
<div class="flex items-center gap-1">
<button class="px-3.5 py-1.5 rounded-lg bg-primary text-white text-sm font-semibold">1</button>
<button class="px-3.5 py-1.5 rounded-lg hover:bg-white text-secondary text-sm font-medium">2</button>
<button class="px-3.5 py-1.5 rounded-lg hover:bg-white text-secondary text-sm font-medium">3</button>
