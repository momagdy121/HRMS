</div>
</div>
<!-- Description Input -->
<div class="space-y-base">
<label class="text-label-bold text-slate-500 uppercase">Description</label>
<input class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" placeholder="e.g. Q3 Performance Bonus" type="text"/>
</div>
<!-- Amount Input -->
<div class="space-y-base">
<label class="text-label-bold text-slate-500 uppercase">Amount</label>
<div class="relative">
<span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium">$</span>
<input class="w-full pl-8 pr-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-primary/20 focus:border-primary outline-none transition-all" placeholder="0.00" type="number"/>
</div>
</div>
</div>
<!-- Footer -->
<div class="px-lg py-md bg-slate-50 flex justify-end gap-md">
<a asp-action="ProcessStep3" asp-route-showModal="false" class="px-6 py-2 text-sm font-label-bold text-slate-600 hover:bg-slate-100 rounded-lg transition-colors inline-block text-center">Cancel</a>
<a asp-action="ProcessStep3" asp-route-showModal="false" class="px-6 py-2 text-sm font-label-bold bg-[#1F4E79] text-white rounded-lg hover:bg-primary shadow-sm transition-all active:scale-95 inline-block text-center">Add Item</a>
</div>
</div>
</div></div>
</div>


