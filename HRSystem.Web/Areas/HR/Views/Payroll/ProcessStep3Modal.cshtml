<h3 class="font-h3 text-h3 text-primary">Add Adjustment</h3>
<a asp-action="ProcessStep3" asp-route-showModal="false" class="text-slate-400 hover:text-slate-600"><span class="material-symbols-outlined">close</span></a>
</div>
<div class="p-lg space-y-md">
<!-- Type Toggle -->
<div class="space-y-base">
<label class="text-label-bold text-slate-500 uppercase">Type</label>
<div class="flex p-1 bg-slate-100 rounded-lg">
