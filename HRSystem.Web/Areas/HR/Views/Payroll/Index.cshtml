@model HrPayrollIndexViewModel
@{
    ViewBag.Title = "Payroll - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-h1 text-h1 text-on-surface">Payroll</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Process and manage employee payroll</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="ExportCsv" asp-route-departmentId="@Model.DepartmentFilter" asp-route-month="@Model.MonthFilter" asp-route-year="@Model.YearFilter" asp-route-status="@Model.StatusFilter" asp-route-search="@Model.Search" class="bg-surface border border-slate-200 text-slate-700 px-4 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-slate-50 transition-colors shadow-sm" title="Export filtered payroll records to CSV (Excel compatible)">
                <span class="material-symbols-outlined text-sm">download</span>Export CSV
            </a>
            <a asp-action="Index" asp-route-showBatchProcess="true" class="bg-surface border border-outline-variant text-primary-container px-4 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-surface-variant transition-colors shadow-sm">
                <span class="material-symbols-outlined text-sm">dynamic_feed</span>Run Monthly Payroll
            </a>
            <a asp-action="Index" asp-route-showProcess="true" class="bg-primary-container text-on-primary px-5 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-primary transition-colors shadow-sm">
                <span class="material-symbols-outlined text-sm">add</span>Individual Payroll
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="grid grid-cols-1 md:grid-cols-4 gap-4 p-4 bg-white rounded-xl shadow-sm border border-slate-100">
        <div class="flex flex-col gap-1.5">
            <label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Department</label>
            <select name="departmentId" class="border-slate-200 rounded-lg text-sm font-body-md px-3 py-2">
                <option value="">All Departments</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept.Id" selected="@(Model.DepartmentFilter == dept.Id)">@dept.Name</option>
                }
            </select>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Month</label>
            <select name="month" class="border-slate-200 rounded-lg text-sm font-body-md px-3 py-2">
                <option value="">All Months</option>
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.MonthFilter == m)">@PayrollDisplayHelper.GetMonthName(m)</option>
                }
            </select>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Year</label>
            <select name="year" class="border-slate-200 rounded-lg text-sm font-body-md px-3 py-2">
                <option value="">All Years</option>
                @for (var y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 3; y--)
                {
                    <option value="@y" selected="@(Model.YearFilter == y)">@y</option>
                }
            </select>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Status</label>
            <select name="status" class="border-slate-200 rounded-lg text-sm font-body-md px-3 py-2">
                <option value="">All Statuses</option>
                @foreach (var status in Enum.GetValues<HRSystem.Common.Enums.PayrollStatus>())
                {
                    <option value="@((int)status)" selected="@(Model.StatusFilter == status)">@PayrollDisplayHelper.GetStatusLabel(status)</option>
                }
            </select>
        </div>
        <div class="md:col-span-4 flex justify-end">
            <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold">Apply Filters</button>
        </div>
    </form>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
            <p class="text-xs font-label-bold text-slate-500 uppercase tracking-widest">Total Net (filtered)</p>
            <p class="text-xl font-bold text-primary mt-1">@PayrollDisplayHelper.FormatCurrency(Model.TotalNetForPeriod)</p>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-label-bold text-slate-500 uppercase tracking-widest">Pending Drafts</p>
                    <p class="text-xl font-bold text-amber-600 mt-1">@Model.PendingApprovalCount</p>
                </div>
                @if (Model.PendingApprovalCount > 0)
                {
                    <form asp-action="BulkApprove" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.MonthFilter" />
                        <input type="hidden" name="year" value="@Model.YearFilter" />
                        <input type="hidden" name="departmentId" value="@Model.DepartmentFilter" />
                        <button type="submit" class="px-3 py-1.5 bg-green-50 text-green-700 border border-green-200 rounded-lg text-xs font-label-bold hover:bg-green-100 transition-colors flex items-center gap-1"
                                onclick="return confirm('Approve all @Model.PendingApprovalCount draft payroll(s)? Employees will receive an in-app notification.');">
                            <span class="material-symbols-outlined text-xs">check_circle</span>Approve All
                        </button>
                    </form>
                }
            </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-label-bold text-slate-500 uppercase tracking-widest">Awaiting Payment</p>
                    <p class="text-xl font-bold text-blue-600 mt-1">@Model.ApprovedPendingPayCount</p>
                </div>
                @if (Model.ApprovedPendingPayCount > 0)
                {
                    <form asp-action="BulkMarkPaid" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="month" value="@Model.MonthFilter" />
                        <input type="hidden" name="year" value="@Model.YearFilter" />
                        <input type="hidden" name="departmentId" value="@Model.DepartmentFilter" />
                        <button type="submit" class="px-3 py-1.5 bg-blue-50 text-blue-700 border border-blue-200 rounded-lg text-xs font-label-bold hover:bg-blue-100 transition-colors flex items-center gap-1"
                                onclick="return confirm('Mark all @Model.ApprovedPendingPayCount approved payroll(s) as paid? This will send payslip emails to all employees.');">
                            <span class="material-symbols-outlined text-xs">payments</span>Mark All Paid
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Employee</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Month/Year</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Base Salary</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Bonuses</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Deductions</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Net Salary</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                    @if (Model.Payrolls.Count == 0)
                    {
                        <tr><td colspan="8" class="px-6 py-12 text-center text-on-surface-variant">No payroll records found.</td></tr>
                    }
                    @foreach (var payroll in Model.Payrolls)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">@payroll.EmployeeInitials</div>
                                    <div>
                                        <p class="font-semibold">@payroll.EmployeeName</p>
                                        <p class="text-body-sm text-slate-500">@payroll.DepartmentName</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">@PayrollDisplayHelper.GetPeriodLabel(payroll.Month, payroll.Year)</td>
                            <td class="px-6 py-4">@PayrollDisplayHelper.FormatCurrency(payroll.BaseSalary)</td>
                            <td class="px-6 py-4 text-green-600">+@PayrollDisplayHelper.FormatCurrency(payroll.TotalBonus)</td>
                            <td class="px-6 py-4 text-error">-@PayrollDisplayHelper.FormatCurrency(payroll.TotalDeduction)</td>
                            <td class="px-6 py-4 font-bold">@PayrollDisplayHelper.FormatCurrency(payroll.NetSalary)</td>
                            <td class="px-6 py-4">
                                <span class="@PayrollDisplayHelper.GetStatusBadgeClass(payroll.Status) px-3 py-1 rounded-full text-xs font-medium">@PayrollDisplayHelper.GetStatusLabel(payroll.Status)</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Payslip" asp-route-id="@payroll.Id" target="_blank" class="p-1.5 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded transition-colors" title="Print Payslip">
                                        <span class="material-symbols-outlined text-sm">print</span>
                                    </a>
                                    <a asp-action="Detail" asp-route-id="@payroll.Id" class="p-1.5 text-slate-500 hover:text-primary hover:bg-slate-50 rounded transition-colors" title="View / Manage">
                                        <span class="material-symbols-outlined text-sm">visibility</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Modals {
    <div id="processPayrollModal" class="modal-overlay @(Model.ShowProcessModal ? "active" : "")">
        <div class="modal-content w-full max-w-md mx-4 p-xl">
            <div class="flex justify-between items-center mb-lg">
                <h3 class="font-h2 text-h2 text-on-surface">Process Payroll</h3>
                <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
            </div>
            <form asp-action="Process" method="post" class="space-y-md">
                @Html.AntiForgeryToken()
                <partial name="_ModalFormErrors" model="@("ProcessForm")" />
                <div>
                    <label asp-for="ProcessForm.EmployeeId" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                    <select asp-for="ProcessForm.EmployeeId" asp-items="@(new SelectList(Model.Employees, "Id", "Name"))" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md">
                        <option value="">Select employee</option>
                    </select>
                    <span asp-validation-for="ProcessForm.EmployeeId" class="text-error font-body-sm"></span>
                </div>
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label asp-for="ProcessForm.Month" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <select asp-for="ProcessForm.Month" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@PayrollDisplayHelper.GetMonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="ProcessForm.Year" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="ProcessForm.Year" type="number" min="2000" max="2100" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                    </div>
                </div>
                <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                    <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Create Draft</button>
                </div>
            </form>
        </div>
    </div>

    <div id="batchPayrollModal" class="modal-overlay @(Model.ShowBatchProcessModal ? "active" : "")">
        <div class="modal-content w-full max-w-md mx-4 p-xl bg-white rounded-xl shadow-xl">
            <div class="flex justify-between items-center mb-lg">
                <h3 class="font-h2 text-h2 text-on-surface">Run Monthly Payroll</h3>
                <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
            </div>
            <div class="bg-blue-50 border border-blue-200 text-blue-900 rounded-lg p-3 text-xs mb-4">
                <p>This action creates draft payroll records for <strong>all active employees</strong> in the selected period. Any employee who already has a payroll record for this month/year will be automatically skipped.</p>
            </div>
            <form asp-action="BatchProcess" method="post" class="space-y-md">
                @Html.AntiForgeryToken()
                <partial name="_ModalFormErrors" model="@("BatchProcessForm")" />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label asp-for="BatchProcessForm.Month" class="block font-label-bold text-on-surface-variant mb-xs text-xs uppercase tracking-wider"></label>
                        <select asp-for="BatchProcessForm.Month" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md text-sm">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@PayrollDisplayHelper.GetMonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="BatchProcessForm.Year" class="block font-label-bold text-on-surface-variant mb-xs text-xs uppercase tracking-wider"></label>
                        <input asp-for="BatchProcessForm.Year" type="number" min="2000" max="2100" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md text-sm" />
                    </div>
                </div>
                <div>
                    <label asp-for="BatchProcessForm.DepartmentId" class="block font-label-bold text-on-surface-variant mb-xs text-xs uppercase tracking-wider">Department</label>
                    <select asp-for="BatchProcessForm.DepartmentId" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md text-sm">
                        <option value="">All Departments (Entire Company)</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>
                <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                    <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold text-sm">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold text-sm shadow-sm flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm">play_arrow</span>Generate Drafts
                    </button>
                </div>
            </form>
        </div>
    </div>
}
