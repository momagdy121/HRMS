@model HRSystem.Web.ViewModels.Recruitment.JobPostingFormViewModel
@{
    ViewBag.Title = "Create Job Opening";
}

<div class="max-w-4xl mx-auto space-y-6 font-['Inter']">
    <div class="flex items-center justify-between">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900 transition">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to Job Postings
        </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 p-8 shadow-sm">
        <div class="border-b border-slate-100 pb-5 mb-6">
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Create New Job Opening</h1>
            <p class="text-xs text-slate-500 mt-1">
                New job postings will be created as <strong>Draft</strong>. You can review and publish them whenever you are ready.
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm">
                <ul class="list-disc pl-5 space-y-1">
                    @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            <!-- Job Title -->
            <div>
                <label asp-for="Title" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                <input asp-for="Title" placeholder="e.g. Senior Backend Engineer (.NET)"
                       class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent transition" />
                <span asp-validation-for="Title" class="text-rose-600 text-xs mt-1 block"></span>
            </div>

            <!-- Department & Closing Date Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="DepartmentId" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                    <select asp-for="DepartmentId" asp-items="Model.Departments"
                            class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent transition">
                        <option value="">-- Select Department --</option>
                    </select>
                    <span asp-validation-for="DepartmentId" class="text-rose-600 text-xs mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ClosingDate" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                    <input asp-for="ClosingDate" type="date"
                           class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent transition" />
                    <span asp-validation-for="ClosingDate" class="text-rose-600 text-xs mt-1 block"></span>
                </div>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                <textarea asp-for="Description" rows="6" placeholder="Provide a detailed overview of the role, team, and day-to-day responsibilities..."
                          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent transition leading-relaxed"></textarea>
                <span asp-validation-for="Description" class="text-rose-600 text-xs mt-1 block"></span>
            </div>

            <!-- Requirements -->
            <div>
                <label asp-for="Requirements" class="block text-sm font-semibold text-slate-800 mb-1.5"></label>
                <textarea asp-for="Requirements" rows="6" placeholder="List required skills, qualifications, certifications, and years of experience..."
                          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4e79] focus:border-transparent transition leading-relaxed"></textarea>
                <span asp-validation-for="Requirements" class="text-rose-600 text-xs mt-1 block"></span>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a asp-action="Index" class="px-5 py-2.5 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 font-semibold text-sm transition">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2.5 rounded-lg bg-[#1f4e79] hover:bg-[#163a5b] text-white font-bold text-sm shadow transition flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">save</span>
                    Save as Draft
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
