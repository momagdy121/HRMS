@model HRSystem.Web.ViewModels.Recruitment.ApplicationDetailsViewModel
@using HRSystem.Common.Enums
@{
    ViewBag.Title = $"Application: {Model.Application.FullName}";
    var app = Model.Application;
}

<div class="max-w-5xl mx-auto space-y-6 font-['Inter']">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <div>
            <a asp-action="Applications" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-800 transition mb-2">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Back to All Applications
            </a>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">@app.FullName</h1>
                @switch (app.Status)
                {
                    case JobApplicationStatus.Submitted:
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-sky-50 text-sky-700 border border-sky-200">
                            <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                            Submitted
                        </span>
                        break;
                    case JobApplicationStatus.Accepted:
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            <span class="material-symbols-outlined text-xs">check_circle</span>
                            Accepted
                        </span>
                        break;
                    case JobApplicationStatus.Rejected:
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                            <span class="material-symbols-outlined text-xs">cancel</span>
                            Rejected
                        </span>
                        break;
                }
            </div>
            <p class="text-xs text-slate-500 mt-1">
                Applied for <strong class="text-slate-700">@app.JobPosting.Title</strong> &bull; @app.JobPosting.Department?.Name &bull; Submitted @app.SubmittedAt.ToString("MMMM dd, yyyy 'at' hh:mm tt 'UTC'")
            </p>
        </div>

        <!-- Quick Status Actions -->
        <div class="flex flex-wrap items-center gap-2">
            @if (app.Status == JobApplicationStatus.Submitted)
            {
                <form asp-action="Accept" asp-route-id="@app.Id" method="post" class="inline"
                      onsubmit="return confirm('Accept this candidate? You can onboard them and create their employee account next.');">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow transition flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm">check</span>
                        Accept Candidate
                    </button>
                </form>

                <form asp-action="Reject" asp-route-id="@app.Id" method="post" class="inline"
                      onsubmit="return confirm('Reject this application? A professional rejection email will be sent automatically to the candidate.');">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow transition flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-sm">close</span>
                        Reject Candidate
                    </button>
                </form>
            }
            else if (app.Status == JobApplicationStatus.Accepted && !app.CreatedEmployeeId.HasValue)
            {
                <a asp-action="Onboard" asp-route-id="@app.Id"
                   class="px-6 py-2.5 rounded-xl bg-[#1f4e79] hover:bg-[#163a5b] text-white font-bold text-xs shadow transition flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">person_add</span>
                    Create Employee Account
                </a>
            }
        </div>
    </div>

    <!-- Onboarding / Status Notifications -->
    @if (app.Status == JobApplicationStatus.Accepted)
    {
        @if (app.CreatedEmployeeId.HasValue)
        {
            <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined">badge</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-emerald-900 text-sm">Employee Account Active</h4>
                        <p class="text-xs text-emerald-700">
                            Employee ID: #@app.CreatedEmployeeId.Value &bull; Account created and associated with this hiring record.
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <a asp-area="HR" asp-controller="Employee" asp-action="Details" asp-route-id="@app.CreatedEmployeeId.Value"
                       class="px-4 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs transition">
                        View Employee Profile
                    </a>
                    @if (!app.AcceptanceEmailSent)
                    {
                        <button type="button" onclick="document.getElementById('retryOnboardModal').classList.remove('hidden')"
                                class="px-3 py-2 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-semibold text-xs transition">
                            Retry Credentials Email
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="p-5 rounded-2xl bg-sky-50 border border-sky-200 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-sky-700 text-2xl">info</span>
                    <div>
                        <h4 class="font-bold text-sky-900 text-sm">Ready for Onboarding</h4>
                        <p class="text-xs text-sky-700">This candidate is accepted. Click the button to create their employee profile and generate their initial credentials.</p>
                    </div>
                </div>
                <a asp-action="Onboard" asp-route-id="@app.Id"
                   class="px-4 py-2 rounded-lg bg-[#1f4e79] hover:bg-[#163a5b] text-white font-bold text-xs transition whitespace-nowrap">
                    Onboard Now
                </a>
            </div>
        }
    }
    else if (app.Status == JobApplicationStatus.Rejected && !app.RejectionEmailSent)
    {
        <div class="p-5 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-amber-700 text-2xl">warning</span>
                <div>
                    <h4 class="font-bold text-amber-900 text-sm">Rejection Email Not Delivered</h4>
                    <p class="text-xs text-amber-700">The application was rejected, but the automated email failed to send to the candidate.</p>
                </div>
            </div>
            <form asp-action="RetryRejectionEmail" asp-route-id="@app.Id" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-4 py-2 rounded-lg bg-amber-700 hover:bg-amber-800 text-white font-bold text-xs transition whitespace-nowrap">
                    Retry Email
                </button>
            </form>
        </div>
    }

    <!-- Candidate Overview & CV Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Candidate Profile Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm space-y-4">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Candidate Contact</h3>
            <div class="space-y-3 text-sm">
                <div>
                    <span class="text-xs text-slate-500 block">Full Name</span>
                    <span class="font-bold text-slate-800">@app.FullName</span>
                </div>
                <div>
                    <span class="text-xs text-slate-500 block">Email Address</span>
                    <a href="mailto:@app.Email" class="font-medium text-sky-700 hover:underline">@app.Email</a>
                </div>
                <div>
                    <span class="text-xs text-slate-500 block">Phone Number</span>
                    <span class="font-medium text-slate-800">@app.PhoneNumber</span>
                </div>
                <div>
                    <span class="text-xs text-slate-500 block">Submission Date</span>
                    <span class="text-slate-700">@app.SubmittedAt.ToString("MMM dd, yyyy hh:mm tt") UTC</span>
                </div>
                @if (app.ReviewedById.HasValue)
                {
                    <div class="pt-3 border-t border-slate-100">
                        <span class="text-xs text-slate-500 block">Evaluated By</span>
                        <span class="font-medium text-slate-800">@(app.ReviewedBy != null ? $"{app.ReviewedBy.FirstName} {app.ReviewedBy.LastName}" : $"User #{app.ReviewedById}")</span>
                        <span class="text-xs text-slate-400 block">@app.ReviewedAt?.ToString("MMM dd, yyyy")</span>
                    </div>
                }
            </div>

            <!-- CV Download Box -->
            <div class="pt-4 border-t border-slate-100">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Resume / CV Document</h3>
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-center">
                    <span class="material-symbols-outlined text-3xl text-sky-700 mb-1">description</span>
                    <div class="font-semibold text-slate-800 text-xs truncate max-w-full" title="@app.CvOriginalFileName">
                        @app.CvOriginalFileName
                    </div>
                    <div class="text-[11px] text-slate-400 mt-0.5 mb-3">
                        @((app.CvFileSize / 1024.0 / 1024.0).ToString("0.00")) MB &bull; @app.CvContentType
                    </div>
                    <a asp-action="DownloadCv" asp-route-id="@app.Id"
                       class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#1f4e79] hover:bg-[#163a5b] text-white font-bold text-xs shadow-sm transition w-full justify-center">
                        <span class="material-symbols-outlined text-sm">download</span>
                        Download / Preview CV
                    </a>
                </div>
            </div>
        </div>

        <!-- Cover Letter & Internal Review Notes -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Cover Letter -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Cover Letter</h3>
                @if (string.IsNullOrWhiteSpace(app.CoverLetter))
                {
                    <p class="text-slate-400 text-sm italic">No cover letter was submitted with this application.</p>
                }
                else
                {
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-slate-700 text-sm leading-relaxed whitespace-pre-line">
                        @app.CoverLetter
                    </div>
                }
            </div>

            <!-- Review Notes -->
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-sm">
                <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Internal Review Notes</h3>
                <p class="text-xs text-slate-500 mb-4">Add interview evaluation feedback, scoring, or candidate notes (internal only).</p>

                <form asp-action="UpdateNotes" asp-route-id="@app.Id" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <textarea name="notes" rows="4" placeholder="Enter confidential interview notes, salary expectations, or evaluation remarks..."
                              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#1f4e79] leading-relaxed">@app.ReviewNotes</textarea>
                    <div class="flex justify-end">
                        <button type="submit"
                                class="px-5 py-2 rounded-lg bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs transition flex items-center gap-1.5 shadow-sm">
                            <span class="material-symbols-outlined text-sm">save</span>
                            Save Notes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Retrying Onboarding Email -->
<div id="retryOnboardModal" class="hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Resend Onboarding Credentials</h3>
        <p class="text-xs text-slate-500 mb-4">
            Specify a temporary password to include in the credentials email. Note: the employee will be forced to change this password on their first login.
        </p>
        <form asp-action="RetryOnboardingEmail" asp-route-id="@app.Id" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Temporary Initial Password</label>
                <input type="text" name="temporaryPassword" value="Welcome#@Random.Shared.Next(100000, 999999)!" required
                       class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm font-mono focus:ring-2 focus:ring-[#1f4e79]" />
            </div>
            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="document.getElementById('retryOnboardModal').classList.add('hidden')"
                        class="px-4 py-2 rounded-lg border border-slate-300 text-slate-700 text-xs font-semibold">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2 rounded-lg bg-[#1f4e79] hover:bg-[#163a5b] text-white text-xs font-bold shadow">
                    Send Email
                </button>
            </div>
        </form>
    </div>
</div>
