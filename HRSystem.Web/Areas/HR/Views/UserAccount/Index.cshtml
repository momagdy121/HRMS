@model HrUserAccountIndexViewModel
@{
    ViewBag.Title = "User Accounts - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-h1 text-h1 text-on-surface">User Accounts</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Manage user credentials</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Employee</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Email</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Role</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                    @if (Model.Accounts.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-on-surface-variant">No user accounts found.</td>
                        </tr>
                    }
                    @foreach (var account in Model.Accounts)
                    {
                        <tr class="striped-row hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">
                                        @account.Initials
                                    </div>
                                    <div>
                                        <div class="font-medium">@account.FullName</div>
                                        @if (account.IsPasswordChangeRequired)
                                        {
                                            <div class="text-xs text-amber-700">Password change required</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-600">@account.Email</td>
                            <td class="px-6 py-4">
                                @{
                                    var badgeClass = account.Role switch
                                    {
                                        HRSystem.Common.Constants.RoleNames.HR => "bg-primary-container/10 text-primary-container",
                                        HRSystem.Common.Constants.RoleNames.DepartmentHead => "bg-amber-50 text-amber-700",
                                        _ => "bg-slate-100 text-slate-600"
                                    };
                                }
                                <span class="@badgeClass px-2.5 py-0.5 rounded-full text-xs font-medium">@account.Role</span>
                            </td>
                            <td class="px-6 py-4">
                                @if (account.IsEmployeeDeleted)
                                {
                                    <span class="bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full text-xs font-medium">Deleted</span>
                                }
                                else if (!account.IsActive)
                                {
                                    <span class="bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full text-xs font-medium">Inactive</span>
                                }
                                else
                                {
                                    <span class="bg-green-50 text-green-700 px-2.5 py-0.5 rounded-full text-xs font-medium">Active</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a asp-action="Index" asp-route-page="@Model.Page" asp-route-resetPasswordUserId="@account.UserId" class="text-secondary hover:underline text-sm font-medium">Reset Password</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Modals {
    @if (Model.ResetPasswordForm != null)
    {
        <div id="resetPwdModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-sm mx-4 p-xl">
                <div class="flex justify-between items-center mb-md">
                    <h3 class="font-h2 text-h2 text-on-surface">Reset Password</h3>
                    <a asp-action="Index" asp-route-page="@Model.Page" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                </div>
                <p class="font-body-md text-on-surface-variant mb-md">Reset password for <strong>@Model.ResetPasswordForm.FullName</strong>?</p>
                <form asp-action="ResetPassword" method="post" class="space-y-md">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ResetPasswordForm.UserId" />
                    <input type="hidden" asp-for="ResetPasswordForm.Page" />
                    <partial name="_ModalFormErrors" model="@("ResetPasswordForm")" />
                    <div>
                        <label asp-for="ResetPasswordForm.NewPassword" class="block font-label-bold text-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="ResetPasswordForm.NewPassword" type="password" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                        <span asp-validation-for="ResetPasswordForm.NewPassword" class="text-error font-body-sm"></span>
                    </div>
                    <div>
                        <label asp-for="ResetPasswordForm.ConfirmPassword" class="block font-label-bold text-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="ResetPasswordForm.ConfirmPassword" type="password" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                        <span asp-validation-for="ResetPasswordForm.ConfirmPassword" class="text-error font-body-sm"></span>
                    </div>
                    <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                        <a asp-action="Index" asp-route-page="@Model.Page" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                        <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Reset</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
