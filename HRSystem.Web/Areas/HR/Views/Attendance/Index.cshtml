@model HrAttendanceIndexViewModel
@{
    ViewBag.Title = "Attendance - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div>
        <h2 class="font-h1 text-h1 text-on-surface">Attendance</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">Daily attendance records</p>
    </div>

    <!-- Filters -->
    <form asp-action="Index" method="get" class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-wrap gap-4 items-end">
        <div class="flex flex-col gap-1.5">
            <label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Date</label>
            <input name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="border-slate-200 rounded-lg text-sm font-body-md focus:border-primary focus:ring-0 px-3 py-2" />
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="font-label-bold text-slate-500 text-[11px] uppercase tracking-wider">Department</label>
            <select name="departmentId" class="border-slate-200 rounded-lg text-sm font-body-md focus:border-primary focus:ring-0 px-3 py-2">
                <option value="">All Departments</option>
                @foreach (var dept in Model.Departments)
                {
                    <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">@dept.Name</option>
                }
            </select>
        </div>
        <div class="flex-1"></div>
        <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold">Apply</button>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Employee</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Department</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Check In</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Check Out</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Notes</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                @if (Model.Records.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-on-surface-variant">No attendance records found.</td>
                    </tr>
                }
                @foreach (var row in Model.Records)
                {
                    <tr class="striped-row hover:bg-slate-50/80 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">@row.EmployeeInitials</div>
                                <span class="font-medium">@row.EmployeeName</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-slate-600">@row.DepartmentName</td>
                        <td class="px-6 py-4">@AttendanceDisplayHelper.FormatTime(row.CheckInTime)</td>
                        <td class="px-6 py-4">@AttendanceDisplayHelper.FormatTime(row.CheckOutTime)</td>
                        <td class="px-6 py-4">
                            <span class="@AttendanceDisplayHelper.GetStatusBadgeClass(row.StatusLabel) px-2.5 py-0.5 rounded-full text-xs font-medium">@row.StatusLabel</span>
                        </td>
                        <td class="px-6 py-4 text-slate-500 text-sm">@(string.IsNullOrWhiteSpace(row.Notes) ? "—" : row.Notes)</td>
                    </tr>
                }
            </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="bg-surface-container-low px-4 py-3 border-t border-outline-variant/30 flex items-center justify-between">
                <div class="font-body-sm text-on-surface-variant">
                    @{
                        var start = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
                        var end = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                    }
                    Showing <span class="font-medium text-on-surface">@start</span> to <span class="font-medium text-on-surface">@end</span> of <span class="font-medium text-on-surface">@Model.TotalCount</span> entries
                </div>
                <div class="flex gap-1">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> { ["page"] = (Model.Page - 1).ToString(), ["date"] = Model.Date.ToString("yyyy-MM-dd"), ["departmentId"] = Model.DepartmentId?.ToString() })" class="px-3 py-1 border border-outline-variant/50 rounded text-on-surface hover:bg-surface-container">Previous</a>
                    }
                    <span class="px-3 py-1 bg-primary text-on-primary rounded font-medium">@Model.Page</span>
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> { ["page"] = (Model.Page + 1).ToString(), ["date"] = Model.Date.ToString("yyyy-MM-dd"), ["departmentId"] = Model.DepartmentId?.ToString() })" class="px-3 py-1 border border-outline-variant/50 rounded text-on-surface hover:bg-surface-container">Next</a>
                    }
                </div>
            </div>
        }
    </div>
</div>
