@model HRSystem.Web.ViewModels.HR.DepartmentIndexViewModel
@{
    ViewBag.Title = "Departments - HRMS Portal";
    var isDeletedView = ViewContext.RouteData.Values["action"]?.ToString() == "Deleted";
}

<div class="max-w-7xl mx-auto space-y-lg">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h2 class="font-h1 text-h1 text-on-background">Departments</h2>
            <p class="font-body-md text-body-md text-secondary">@(isDeletedView ? "Restore deleted departments" : "Manage organization structure")</p>
        </div>
        <div class="flex items-center gap-sm bg-surface-container-high p-1 rounded-full w-fit">
            <a asp-action="Index" class="px-6 py-2 rounded-full text-label-bold @(isDeletedView ? "text-secondary hover:text-primary-container" : "bg-white shadow-sm text-primary-container font-semibold")">Active Departments</a>
            <a asp-action="Deleted" class="px-6 py-2 rounded-full text-label-bold @(!isDeletedView ? "text-secondary hover:text-primary-container" : "bg-white shadow-sm text-primary-container font-semibold")">Deleted Departments</a>
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-2xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-slate-200/50 overflow-hidden">
        <div class="px-lg py-md border-b border-slate-100 flex items-center justify-between">
            @if (!isDeletedView)
            {
                <div></div>
                <a asp-action="Index" asp-route-showCreate="true" class="flex items-center gap-2 bg-primary-container text-white px-6 py-2.5 rounded-lg text-label-bold shadow-md hover:bg-primary transition-all">
                    <span class="material-symbols-outlined text-sm">add</span>Create Department
                </a>
            }
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left bg-slate-50/20">
                <thead>
                    <tr class="bg-slate-50/50">
                        <th class="px-lg py-4 font-label-bold text-slate-500 uppercase tracking-wider">Name</th>
                        <th class="px-lg py-4 font-label-bold text-slate-500 uppercase tracking-wider">Manager</th>
                        <th class="px-lg py-4 font-label-bold text-slate-500 uppercase tracking-wider text-center">Employee Count</th>
                        <th class="px-lg py-4 font-label-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var dept in Model.Departments)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-lg py-5 font-body-lg font-semibold text-slate-900">@dept.Name</td>
                            <td class="px-lg py-5">
                                @if (dept.HasManager)
                                {
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-sm">@dept.ManagerInitials</div>
                                        <span class="text-body-md font-medium text-slate-700">@dept.ManagerName</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-body-sm italic text-slate-400">(Unassigned)</span>
                                }
                            </td>
                            <td class="px-lg py-5 text-center">
                                <span class="inline-flex items-center justify-center px-3 py-1 bg-sky-50 text-sky-700 rounded-full font-badge">@dept.EmployeeCount</span>
                            </td>
                            <td class="px-lg py-5 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    @if (isDeletedView)
                                    {
                                        <form asp-action="Restore" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@dept.Id" />
                                            <button type="submit" class="p-2 text-primary hover:text-primary transition-colors" title="Restore"><span class="material-symbols-outlined text-lg">restore</span></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-action="Index" asp-route-editId="@dept.Id" class="p-2 text-slate-500 hover:text-primary transition-colors" title="Edit"><span class="material-symbols-outlined text-lg">edit</span></a>
                                        <a asp-action="Index" asp-route-replaceId="@dept.Id" class="p-2 text-slate-500 hover:text-amber-600 transition-colors" title="Replace Manager"><span class="material-symbols-outlined text-lg">swap_horiz</span></a>
                                        <form asp-action="Delete" method="post" class="inline" onsubmit="return confirm('Delete this department?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@dept.Id" />
                                            <button type="submit" class="p-2 text-error hover:bg-error-container rounded-lg transition-colors" title="Delete"><span class="material-symbols-outlined text-lg">delete</span></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Departments.Any())
                    {
                        <tr><td colspan="4" class="py-8 text-center text-secondary">No departments found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@if (!isDeletedView)
{
    @section Modals {
        <div id="createDeptModal" class="modal-overlay @(Model.ShowCreateModal ? "active" : "")">
            <div class="modal-content w-full max-w-md mx-4 p-xl">
                <div class="flex justify-between items-center mb-lg">
                    <h3 class="font-h2 text-h2 text-on-surface">Create Department</h3>
                    <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                </div>
                <form asp-action="Create" method="post" class="space-y-md">
                    @Html.AntiForgeryToken()
                    <partial name="_ModalFormErrors" model="@("CreateForm")" />
                    <div>
                        <label asp-for="CreateForm.Name" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="CreateForm.Name" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" placeholder="e.g. Marketing" />
                        <span asp-validation-for="CreateForm.Name" class="text-error font-body-sm"></span>
                    </div>
                    <div>
                        <label asp-for="CreateForm.ManagerId" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <select asp-for="CreateForm.ManagerId" asp-items="@(new SelectList(Model.ManagerOptions, "Id", "Name"))" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md">
                            <option value="">Select a manager</option>
                        </select>
                        <span asp-validation-for="CreateForm.ManagerId" class="text-error font-body-sm"></span>
                    </div>
                    <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                        <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg font-label-bold">Cancel</a>
                        <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Create</button>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.EditForm != null)
        {
            <div id="editDeptModal" class="modal-overlay active">
                <div class="modal-content w-full max-w-md mx-4 p-xl">
                    <div class="flex justify-between items-center mb-lg">
                        <h3 class="font-h2 text-h2 text-on-surface">Edit Department</h3>
                        <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                    </div>
                    <form asp-action="Edit" method="post" class="space-y-md">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="EditForm!.Id" />
                        <partial name="_ModalFormErrors" model="@("EditForm")" />
                        <div>
                            <label asp-for="EditForm.Name" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                            <input asp-for="EditForm.Name" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                            <span asp-validation-for="EditForm.Name" class="text-error font-body-sm"></span>
                        </div>
                        <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                            <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg font-label-bold">Cancel</a>
                            <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.ReplaceForm != null)
        {
            <div id="replaceMgrModal" class="modal-overlay active">
                <div class="modal-content w-full max-w-md mx-4 p-xl">
                    <div class="flex justify-between items-center mb-lg">
                        <h3 class="font-h2 text-h2 text-on-surface">Replace Manager</h3>
                        <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                    </div>
                    <p class="font-body-md text-on-surface-variant mb-md">Select a new manager for <strong>@Model.ReplaceForm.DepartmentName</strong>.</p>
                    <form asp-action="ReplaceManager" method="post" class="space-y-md">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReplaceForm!.DepartmentId" />
                        <div>
                            <label asp-for="ReplaceForm.NewManagerId" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                            <select asp-for="ReplaceForm.NewManagerId" asp-items="@(new SelectList(Model.ManagerOptions, "Id", "Name"))" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md">
                                <option value="">Select employee</option>
                            </select>
                            <span asp-validation-for="ReplaceForm.NewManagerId" class="text-error font-body-sm"></span>
                        </div>
                        <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                            <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg font-label-bold">Cancel</a>
                            <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.DeletedNameConflict != null)
        {
            var conflict = Model.DeletedNameConflict;
            <div id="deletedNameConflictModal" class="modal-overlay active">
                <div class="modal-content w-full max-w-md mx-4 p-xl">
                    <div class="flex justify-between items-center mb-lg">
                        <h3 class="font-h2 text-h2 text-on-surface">Name already used</h3>
                        <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                    </div>
                    <div class="flex gap-sm items-start mb-lg">
                        <span class="material-symbols-outlined text-[#b45309] mt-0.5" style="font-variation-settings: 'FILL' 1;">info</span>
                        <p class="font-body-md text-on-surface-variant">
                            A department named <strong>@conflict.Name</strong> was previously deleted.
                            You can restore it or pick a different name.
                        </p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-md pt-md border-t border-outline-variant/30">
                        <form asp-action="RestoreDeleted" method="post" class="flex-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@conflict.DeletedDepartmentId" />
                            @if (conflict.SelectedManagerId is > 0)
                            {
                                <input type="hidden" name="managerId" value="@conflict.SelectedManagerId" />
                            }
                            <button type="submit" class="w-full px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm hover:bg-primary transition-colors">
                                Restore "@conflict.Name"
                            </button>
                        </form>
                        <a asp-action="Index" asp-route-showCreate="@(conflict.FromEdit ? null : true)" class="flex-1 px-6 py-2 border border-outline-variant rounded-lg font-label-bold text-center text-on-surface-variant hover:bg-surface-container transition-colors">
                            Use a different name
                        </a>
                    </div>
                </div>
            </div>
        }
    }

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        @if (Model.ShowCreateModal || Model.EditForm != null || Model.ReplaceForm != null || Model.DeletedNameConflict != null)
        {
            <script>document.addEventListener('DOMContentLoaded', () => { document.body.style.overflow = 'hidden'; });</script>
        }
    }
}
