@model HRSystem.Web.ViewModels.HR.DepartmentDetailViewModel
@{
    ViewBag.Title = $"{Model.Name} Department - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <!-- Breadcrumb & Top Bar -->
    <div>
        <a asp-action="Index" class="inline-flex items-center gap-1.5 text-slate-500 hover:text-primary font-medium text-sm transition-colors mb-3">
            <span class="material-symbols-outlined text-base">arrow_back</span>
            Back to Departments
        </a>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-primary-fixed text-primary-container flex items-center justify-center shadow-sm">
                    <span class="material-symbols-outlined text-2xl">apartment</span>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-bold text-slate-900">@Model.Name</h1>
                        @if (Model.IsDeleted)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">Deleted</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
                        }
                    </div>
                    <p class="text-sm text-slate-500">Department Overview, Team Members & Analytics</p>
                </div>
            </div>

            @if (!Model.IsDeleted)
            {
                <div class="flex items-center gap-2">
                    <button type="button" onclick="openModal('editDeptModal')" class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 rounded-xl text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-all shadow-sm">
                        <span class="material-symbols-outlined text-base">edit</span>
                        Edit Name
                    </button>
                    <button type="button" onclick="openModal('replaceMgrModal')" class="inline-flex items-center gap-2 px-4 py-2 bg-primary-container text-white rounded-xl font-semibold text-sm hover:bg-primary transition-all shadow-sm">
                        <span class="material-symbols-outlined text-base">swap_horiz</span>
                        Replace Manager
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Headcount</p>
                <p class="text-2xl font-black text-slate-900 mt-1">@Model.TotalEmployees</p>
                <p class="text-xs text-slate-500 mt-0.5">Active team members</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined">group</span>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Monthly Payroll</p>
                <p class="text-2xl font-black text-slate-900 mt-1">@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(Model.TotalSalaryBudget)</p>
                <p class="text-xs text-slate-500 mt-0.5">Base salary budget</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined">payments</span>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Average Salary</p>
                <p class="text-2xl font-black text-slate-900 mt-1">@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(Model.AverageSalary)</p>
                <p class="text-xs text-slate-500 mt-0.5">Per team member</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                <span class="material-symbols-outlined">analytics</span>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Department Head</p>
                @if (Model.HasManager)
                {
                    <a asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.ManagerId" class="text-lg font-bold text-slate-900 hover:text-primary transition-colors block truncate max-w-[160px] mt-1" title="@Model.ManagerName">
                        @Model.ManagerName
                    </a>
                    <span class="inline-flex items-center text-[11px] font-bold text-emerald-600 gap-1 mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Assigned
                    </span>
                }
                else
                {
                    <p class="text-lg font-bold text-slate-400 italic mt-1">Unassigned</p>
                    <span class="inline-flex items-center text-[11px] font-bold text-amber-600 gap-1 mt-0.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Vacant
                    </span>
                }
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                <span class="material-symbols-outlined">manage_accounts</span>
            </div>
        </div>
    </div>

    <!-- Manager Spotlight Card -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
            <div>
                <h2 class="text-lg font-bold text-slate-900">Department Leadership</h2>
                <p class="text-xs text-slate-500">Official manager assigned to oversee operations and team reviews</p>
            </div>
            @if (Model.HasManager)
            {
                <a asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.ManagerId" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg text-xs font-bold transition-colors">
                    <span class="material-symbols-outlined text-sm">visibility</span>
                    View Full Profile
                </a>
            }
        </div>

        @if (Model.HasManager)
        {
            <div class="flex flex-col md:flex-row items-center md:items-start gap-6 pt-5">
                @if (!string.IsNullOrWhiteSpace(Model.ManagerAvatarUrl))
                {
                    <img src="@Model.ManagerAvatarUrl" alt="@Model.ManagerName" class="w-20 h-20 rounded-2xl object-cover ring-2 ring-primary-container/20 shadow" />
                }
                else
                {
                    <div class="w-20 h-20 rounded-2xl bg-primary-fixed text-primary-container text-2xl font-bold flex items-center justify-center shadow">
                        @Model.ManagerInitials
                    </div>
                }

                <div class="space-y-3 flex-1 text-center md:text-left">
                    <div>
                        <a asp-controller="Employee" asp-action="Detail" asp-route-id="@Model.ManagerId" class="text-xl font-bold text-slate-900 hover:text-primary transition-colors">
                            @Model.ManagerName
                        </a>
                        <p class="text-xs font-semibold text-primary uppercase tracking-wider mt-0.5">Department Head</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                        <div class="flex items-center gap-2 text-xs text-slate-600 bg-slate-50 px-3 py-2 rounded-xl">
                            <span class="material-symbols-outlined text-sm text-slate-400">mail</span>
                            <span class="truncate">@Model.ManagerEmail</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-slate-600 bg-slate-50 px-3 py-2 rounded-xl">
                            <span class="material-symbols-outlined text-sm text-slate-400">call</span>
                            <span>@(Model.ManagerPhone ?? "No phone recorded")</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-slate-600 bg-slate-50 px-3 py-2 rounded-xl">
                            <span class="material-symbols-outlined text-sm text-slate-400">event</span>
                            <span>@(Model.ManagerHireDate.HasValue ? $"Joined {Model.ManagerHireDate.Value:MMM dd, yyyy}" : "—")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="pt-5 text-center py-6">
                <div class="w-12 h-12 rounded-full bg-amber-50 text-amber-500 mx-auto flex items-center justify-center mb-2">
                    <span class="material-symbols-outlined text-2xl">person_off</span>
                </div>
                <h3 class="text-sm font-bold text-slate-800">No Manager Currently Assigned</h3>
                <p class="text-xs text-slate-500 max-w-md mx-auto mt-1 mb-4">This department currently has no active leader assigned. Assign a manager to facilitate team approval workflows.</p>
                <button type="button" onclick="openModal('replaceMgrModal')" class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary-container text-white rounded-xl text-xs font-bold hover:bg-primary transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-sm">person_add</span>
                    Assign Department Manager
                </button>
            </div>
        }
    </div>

    <!-- Department Employees Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-slate-900">Department Members (@Model.Employees.Count)</h2>
                <p class="text-xs text-slate-500">All personnel currently assigned to this department</p>
            </div>
            <a asp-controller="Employee" asp-action="Index" asp-route-departmentId="@Model.Id" class="inline-flex items-center gap-1 text-xs font-bold text-primary hover:underline">
                Filter on Employees page
                <span class="material-symbols-outlined text-xs">arrow_forward</span>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50/70 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-3.5 font-label-bold text-slate-500 uppercase tracking-wider text-xs">Employee</th>
                        <th class="px-6 py-3.5 font-label-bold text-slate-500 uppercase tracking-wider text-xs">Contact</th>
                        <th class="px-6 py-3.5 font-label-bold text-slate-500 uppercase tracking-wider text-xs text-right">Base Salary</th>
                        <th class="px-6 py-3.5 font-label-bold text-slate-500 uppercase tracking-wider text-xs">Hire Date</th>
                        <th class="px-6 py-3.5 font-label-bold text-slate-500 uppercase tracking-wider text-xs text-center">Status</th>
                        <th class="px-6 py-3.5 font-label-bold text-slate-500 uppercase tracking-wider text-xs text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @if (Model.Employees.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                                No employees currently assigned to this department.
                            </td>
                        </tr>
                    }
                    @foreach (var emp in Model.Employees)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4">
                                <a asp-controller="Employee" asp-action="Detail" asp-route-id="@emp.Id" class="flex items-center gap-3 group">
                                    @if (!string.IsNullOrWhiteSpace(emp.AvatarUrl))
                                    {
                                        <img src="@emp.AvatarUrl" alt="@emp.FullName" class="w-9 h-9 rounded-full object-cover ring-1 ring-slate-200" />
                                    }
                                    else
                                    {
                                        <div class="w-9 h-9 rounded-full bg-primary-fixed text-primary-container font-bold flex items-center justify-center text-xs shadow-sm">
                                            @emp.Initials
                                        </div>
                                    }
                                    <div>
                                        <div class="flex items-center gap-2">
                                            <span class="font-semibold text-slate-900 group-hover:text-primary transition-colors">@emp.FullName</span>
                                            @if (emp.IsManager)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">Manager</span>
                                            }
                                            @if (emp.IsHR)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">HR</span>
                                            }
                                        </div>
                                        <p class="text-xs text-slate-400">@(emp.IsManager ? "Department Manager" : (emp.IsHR ? "HR Specialist" : "Team Member"))</p>
                                    </div>
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-xs text-slate-700">@emp.Email</p>
                                <p class="text-xs text-slate-400">@(emp.PhoneNumber ?? "—")</p>
                            </td>
                            <td class="px-6 py-4 text-right font-semibold text-slate-900">
                                @HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(emp.Salary)
                            </td>
                            <td class="px-6 py-4 text-xs text-slate-600">
                                @emp.HireDate.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (emp.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">Inactive</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a asp-controller="Employee" asp-action="Detail" asp-route-id="@emp.Id" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-primary hover:bg-primary-fixed/30 transition-colors" title="View Profile">
                                    <span class="material-symbols-outlined text-sm">visibility</span>
                                    Profile
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Modals {
    @if (!Model.IsDeleted)
    {
        <!-- Edit Department Modal -->
        <div id="editDeptModal" class="modal-overlay">
            <div class="modal-content w-full max-w-md mx-4 p-6 bg-white rounded-2xl shadow-xl border border-slate-100">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-slate-900">Edit Department</h3>
                    <button type="button" onclick="closeModal('editDeptModal')" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <form asp-action="Edit" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EditForm.Id" value="@Model.Id" />
                    <div>
                        <label for="deptNameInput" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">Department Name</label>
                        <input id="deptNameInput" name="EditForm.Name" value="@Model.Name" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary" />
                    </div>
                    <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
                        <button type="button" onclick="closeModal('editDeptModal')" class="px-4 py-2 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50">Cancel</button>
                        <button type="submit" class="px-5 py-2 bg-primary-container text-white rounded-xl text-xs font-bold hover:bg-primary transition-colors shadow-sm">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Replace Manager Modal -->
        <div id="replaceMgrModal" class="modal-overlay">
            <div class="modal-content w-full max-w-md mx-4 p-6 bg-white rounded-2xl shadow-xl border border-slate-100">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-lg font-bold text-slate-900">Replace Department Manager</h3>
                    <button type="button" onclick="closeModal('replaceMgrModal')" class="p-1 text-slate-400 hover:text-slate-600 rounded-lg">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <p class="text-xs text-slate-500 mb-4">Choose an active team member to assign as the official manager for <strong>@Model.Name</strong>.</p>
                <form asp-action="ReplaceManager" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ReplaceForm.DepartmentId" value="@Model.Id" />
                    <div>
                        <label for="newManagerSelect" class="block text-xs font-bold text-slate-600 uppercase tracking-wider mb-1">Select New Manager</label>
                        <select id="newManagerSelect" name="ReplaceForm.NewManagerId" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-primary">
                            <option value="">-- Choose Employee --</option>
                            @foreach (var opt in Model.ManagerOptions)
                            {
                                <option value="@opt.Id" selected="@(opt.Id == Model.ManagerId)">@opt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
                        <button type="button" onclick="closeModal('replaceMgrModal')" class="px-4 py-2 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-50">Cancel</button>
                        <button type="submit" class="px-5 py-2 bg-primary-container text-white rounded-xl text-xs font-bold hover:bg-primary transition-colors shadow-sm">Confirm Manager</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function openModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('active');
        }
        function closeModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('active');
        }
    </script>
}
