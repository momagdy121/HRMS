@{
    ViewBag.Title = "Manage Tasks - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-h1 text-h1 text-on-surface">Manage Tasks</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Assign and track team tasks</p>
        </div>
        <button onclick="openModal('assignTaskModal')" class="bg-primary-container text-on-primary px-6 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-primary transition-colors shadow-sm">
            <span class="material-symbols-outlined text-sm">add</span>Assign Task
        </button>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Task</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Assigned To</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Due Date</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Priority</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                <tr class="striped-row hover:bg-slate-50/80 transition-colors">
                    <td class="px-6 py-4"><p class="font-medium">Fix Login Bug</p><p class="text-body-sm text-slate-500">Authentication flow issue on mobile</p></td>
                    <td class="px-6 py-4"><div class="flex items-center gap-2"><div class="w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-label-bold text-xs">AB</div><span>Alice Brown</span></div></td>
                    <td class="px-6 py-4"><span class="text-error font-medium">Oct 25, 2025</span></td>
                    <td class="px-6 py-4"><span class="bg-red-50 text-red-700 px-2.5 py-0.5 rounded-full text-xs font-medium">High</span></td>
                    <td class="px-6 py-4"><span class="bg-blue-50 text-blue-700 px-2.5 py-0.5 rounded-full text-xs font-medium">In Progress</span></td>
                    <td class="px-6 py-4 text-right">
                        <button onclick="openModal('editTaskModal')" class="p-1.5 text-slate-500 hover:text-primary rounded" title="Edit"><span class="material-symbols-outlined text-sm">edit</span></button>
                        <button onclick="openModal('cancelTaskModal')" class="p-1.5 text-error hover:bg-error/10 rounded" title="Cancel"><span class="material-symbols-outlined text-sm">cancel</span></button>
                    </td>
                </tr>
                <tr class="striped-row hover:bg-slate-50/80 transition-colors">
                    <td class="px-6 py-4"><p class="font-medium">Update API Docs</p><p class="text-body-sm text-slate-500">REST API v3 documentation</p></td>
                    <td class="px-6 py-4"><div class="flex items-center gap-2"><div class="w-7 h-7 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">EW</div><span>Emily Wong</span></div></td>
                    <td class="px-6 py-4">Oct 30, 2025</td>
                    <td class="px-6 py-4"><span class="bg-yellow-50 text-amber-700 px-2.5 py-0.5 rounded-full text-xs font-medium">Medium</span></td>
                    <td class="px-6 py-4"><span class="bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full text-xs font-medium">Pending</span></td>
                    <td class="px-6 py-4 text-right">
                        <button class="p-1.5 text-slate-500 hover:text-primary rounded"><span class="material-symbols-outlined text-sm">edit</span></button>
                        <button class="p-1.5 text-error hover:bg-error/10 rounded"><span class="material-symbols-outlined text-sm">cancel</span></button>
                    </td>
                </tr>
                <tr class="striped-row hover:bg-slate-50/80 transition-colors">
                    <td class="px-6 py-4"><p class="font-medium">Code Review — Sprint 42</p><p class="text-body-sm text-slate-500">Review PRs for sprint release</p></td>
                    <td class="px-6 py-4"><div class="flex items-center gap-2"><div class="w-7 h-7 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">JD</div><span>John Doe</span></div></td>
                    <td class="px-6 py-4">Nov 1, 2025</td>
                    <td class="px-6 py-4"><span class="bg-green-50 text-green-700 px-2.5 py-0.5 rounded-full text-xs font-medium">Low</span></td>
                    <td class="px-6 py-4"><span class="bg-green-50 text-green-700 px-2.5 py-0.5 rounded-full text-xs font-medium">Completed</span></td>
                    <td class="px-6 py-4 text-right">
                        <button class="p-1.5 text-slate-500 hover:text-primary rounded"><span class="material-symbols-outlined text-sm">visibility</span></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Modals {
    <div id="assignTaskModal" class="modal-overlay">
        <div class="modal-content w-full max-w-md mx-4 p-xl">
            <div class="flex justify-between items-center mb-lg">
                <h3 class="font-h2 text-h2 text-on-surface">Assign Task</h3>
                <button onclick="closeModal('assignTaskModal')" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form class="space-y-md">
                <div><label class="block font-label-bold text-on-surface-variant mb-xs">Title</label><input type="text" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" placeholder="Task title" /></div>
                <div><label class="block font-label-bold text-on-surface-variant mb-xs">Description</label><textarea class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md h-20 resize-none" placeholder="Describe the task..."></textarea></div>
                <div class="grid grid-cols-2 gap-md">
                    <div><label class="block font-label-bold text-on-surface-variant mb-xs">Assign To</label><select class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md appearance-none"><option>Select employee</option><option>Alice Brown</option><option>John Doe</option><option>Emily Wong</option></select></div>
                    <div><label class="block font-label-bold text-on-surface-variant mb-xs">Due Date</label><input type="date" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" /></div>
                </div>
                <div><label class="block font-label-bold text-on-surface-variant mb-xs">Priority</label><select class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md appearance-none"><option>Low</option><option selected>Medium</option><option>High</option></select></div>
                <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                    <button type="button" onclick="closeModal('assignTaskModal')" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</button>
                    <button type="button" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Assign</button>
                </div>
            </form>
        </div>
    </div>
    <div id="editTaskModal" class="modal-overlay">
        <div class="modal-content w-full max-w-md mx-4 p-xl">
            <div class="flex justify-between items-center mb-lg">
                <h3 class="font-h2 text-h2 text-on-surface">Edit Task — Fix Login Bug</h3>
                <button onclick="closeModal('editTaskModal')" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></button>
            </div>
            <form class="space-y-md">
                <div><label class="block font-label-bold text-on-surface-variant mb-xs">Title</label><input type="text" value="Fix Login Bug" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" /></div>
                <div><label class="block font-label-bold text-on-surface-variant mb-xs">Description</label><textarea class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md h-20 resize-none">Authentication flow issue on mobile</textarea></div>
                <div class="grid grid-cols-2 gap-md">
                    <div><label class="block font-label-bold text-on-surface-variant mb-xs">Status</label><select class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md appearance-none"><option>Pending</option><option selected>In Progress</option><option>Completed</option></select></div>
                    <div><label class="block font-label-bold text-on-surface-variant mb-xs">Priority</label><select class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md appearance-none"><option selected>High</option><option>Medium</option><option>Low</option></select></div>
                </div>
                <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                    <button type="button" onclick="closeModal('editTaskModal')" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</button>
                    <button type="button" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Save</button>
                </div>
            </form>
        </div>
    </div>
    <div id="cancelTaskModal" class="modal-overlay">
        <div class="modal-content w-full max-w-sm mx-4 p-xl text-center">
            <div class="w-16 h-16 rounded-full bg-error-container text-error flex items-center justify-center mx-auto mb-lg">
                <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 1;">warning</span>
            </div>
            <h3 class="font-h3 text-h3 text-on-surface mb-sm">Cancel Task?</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-lg">Cancel "Fix Login Bug" assigned to Alice Brown?</p>
            <div class="flex justify-center gap-md">
                <button onclick="closeModal('cancelTaskModal')" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">No, Keep</button>
                <button class="px-6 py-2 bg-error text-on-error rounded-lg font-label-bold shadow-sm">Yes, Cancel</button>
            </div>
        </div>
    </div>
}
