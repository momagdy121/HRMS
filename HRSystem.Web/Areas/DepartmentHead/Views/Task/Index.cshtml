@model DeptHeadTaskIndexViewModel
@{
    ViewBag.Title = "Manage Tasks - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-h1 text-h1 text-on-surface">Manage Tasks</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Assign and track team tasks</p>
        </div>
        <a asp-action="Index" asp-route-showAssign="true" class="bg-primary-container text-on-primary px-6 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-primary transition-colors shadow-sm">
            <span class="material-symbols-outlined text-sm">add</span>Assign Task
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Task</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Assigned To</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Due Date</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                    @if (Model.Tasks.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-on-surface-variant">No tasks assigned yet.</td>
                        </tr>
                    }
                    @foreach (var task in Model.Tasks)
                    {
                        <tr class="striped-row hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4">
                                <p class="font-medium">@task.Title</p>
                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <p class="text-body-sm text-slate-500">@task.Description</p>
                                }
                                @if (task.Status == HRSystem.Common.Enums.TaskStatus.Completed && !string.IsNullOrWhiteSpace(task.CompletionNotes))
                                {
                                    <p class="text-body-sm text-green-700 mt-1">
                                        <span class="font-medium">Completion:</span> @task.CompletionNotes
                                    </p>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">@task.PersonInitials</div>
                                    <span>@task.PersonName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="@(task.IsOverdue ? "text-error font-medium" : "")">@task.DueDate.Value.ToString("MMM d, yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <span class="@TaskDisplayHelper.GetStatusBadgeClass(task.Status) px-2.5 py-0.5 rounded-full text-xs font-medium">@TaskDisplayHelper.GetStatusLabel(task.Status)</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (task.CanEdit)
                                {
                                    <a asp-action="Index" asp-route-editId="@task.Id" class="p-1.5 text-slate-500 hover:text-primary rounded inline-flex" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    <a asp-action="Index" asp-route-cancelId="@task.Id" class="p-1.5 text-error hover:bg-error/10 rounded inline-flex" title="Cancel">
                                        <span class="material-symbols-outlined text-sm">cancel</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-slate-400 text-sm">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Modals {
    <div id="assignTaskModal" class="modal-overlay @(Model.ShowAssignModal ? "active" : "")">
        <div class="modal-content w-full max-w-md mx-4 p-xl">
            <div class="flex justify-between items-center mb-lg">
                <h3 class="font-h2 text-h2 text-on-surface">Assign Task</h3>
                <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
            </div>
            <form asp-action="Assign" method="post" class="space-y-md">
                @Html.AntiForgeryToken()
                <partial name="_ModalFormErrors" model="@("AssignForm")" />
                <div>
                    <label asp-for="AssignForm.Title" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                    <input asp-for="AssignForm.Title" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" placeholder="Task title" />
                    <span asp-validation-for="AssignForm.Title" class="text-error font-body-sm"></span>
                </div>
                <div>
                    <label asp-for="AssignForm.Description" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                    <textarea asp-for="AssignForm.Description" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md h-20 resize-none" placeholder="Describe the task..."></textarea>
                </div>
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label asp-for="AssignForm.AssignedToId" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <select asp-for="AssignForm.AssignedToId" asp-items="@(new SelectList(Model.Assignees, "Id", "Name"))" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md">
                            <option value="">Select employee</option>
                        </select>
                        <span asp-validation-for="AssignForm.AssignedToId" class="text-error font-body-sm"></span>
                    </div>
                    <div>
                        <label asp-for="AssignForm.DueDate" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="AssignForm.DueDate" type="date" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                    </div>
                </div>
                <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                    <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Assign</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.EditForm != null)
    {
        <div id="editTaskModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-md mx-4 p-xl">
                <div class="flex justify-between items-center mb-lg">
                    <h3 class="font-h2 text-h2 text-on-surface">Edit Task</h3>
                    <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                </div>
                <form asp-action="Edit" method="post" class="space-y-md">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EditForm!.Id" />
                    <partial name="_ModalFormErrors" model="@("EditForm")" />
                    <div>
                        <label asp-for="EditForm.Title" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="EditForm.Title" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                        <span asp-validation-for="EditForm.Title" class="text-error font-body-sm"></span>
                    </div>
                    <div>
                        <label asp-for="EditForm.Description" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <textarea asp-for="EditForm.Description" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md h-20 resize-none"></textarea>
                    </div>
                    <div>
                        <label asp-for="EditForm.DueDate" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="EditForm.DueDate" type="date" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                    </div>
                    <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                        <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                        <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Save</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.CancelTarget != null)
    {
        <div id="cancelTaskModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-sm mx-4 p-xl text-center">
                <div class="w-16 h-16 rounded-full bg-error-container text-error flex items-center justify-center mx-auto mb-lg">
                    <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 1;">warning</span>
                </div>
                <h3 class="font-h3 text-h3 text-on-surface mb-sm">Cancel Task?</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mb-lg">
                    Cancel &quot;@Model.CancelTarget.Title&quot; assigned to @Model.CancelTarget.AssigneeName?
                </p>
                <form asp-action="Cancel" method="post" class="flex justify-center gap-md">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.CancelTarget.Id" />
                    <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">No, Keep</a>
                    <button type="submit" class="px-6 py-2 bg-error text-on-error rounded-lg font-label-bold shadow-sm">Yes, Cancel</button>
                </form>
            </div>
        </div>
    }
}
