@model HRSystem.Web.ViewModels.Dashboard.DepartmentHeadDashboardViewModel
@{
    ViewBag.Title = $"My Department — {Model.DepartmentName} - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div>
        <h2 class="font-h1 text-h1 text-on-surface">My Department — @Model.DepartmentName</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">Your team members (@Model.ActiveEmployees total)</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead class="bg-slate-50 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Email</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Role</th>
                    <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                @if (Model.TeamMembers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-on-surface-variant">No team members found in this department.</td>
                    </tr>
                }
                @foreach (var member in Model.TeamMembers)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">
                                    @member.Initials
                                </div>
                                <span class="font-medium">@member.FullName</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-slate-600">@member.Email</td>
                        <td class="px-6 py-4">
                            <span class="bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full text-xs font-medium">@member.Role</span>
                        </td>
                        <td class="px-6 py-4">
                            @if (member.IsActive)
                            {
                                <span class="bg-green-50 text-green-700 px-2.5 py-0.5 rounded-full text-xs font-medium flex items-center gap-1 w-fit">
                                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>Active
                                </span>
                            }
                            else
                            {
                                <span class="bg-slate-100 text-slate-500 px-2.5 py-0.5 rounded-full text-xs font-medium flex items-center gap-1 w-fit">
                                    <span class="w-1.5 h-1.5 bg-slate-400 rounded-full"></span>Inactive
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
