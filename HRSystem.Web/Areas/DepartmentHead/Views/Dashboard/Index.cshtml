@{
    ViewBag.Title = "Engineering Department - HRMS Portal";
}

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-lg">
        <h1 class="font-h1 text-h1 text-primary-container mb-xs">Engineering Department</h1>
        <p class="font-body-lg text-body-lg text-secondary">Team overview and management</p>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md mb-lg">
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container flex flex-col justify-between">
            <div class="flex justify-between items-start mb-md">
                <div class="p-2 bg-primary-fixed/20 rounded-lg text-primary-container">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">groups</span>
                </div>
            </div>
            <div>
                <h3 class="font-h1 text-h1 text-on-surface mb-xs">58</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Active employees</p>
            </div>
        </div>
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container flex flex-col justify-between relative overflow-hidden">
            <div class="absolute right-0 top-0 w-24 h-24 bg-error/5 rounded-bl-full -mr-8 -mt-8"></div>
            <div class="flex justify-between items-start mb-md relative z-10">
                <div class="p-2 bg-error-container text-error rounded-lg">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">event_busy</span>
                </div>
            </div>
            <div class="relative z-10">
                <h3 class="font-h1 text-h1 text-on-surface mb-xs">4</h3>
                <p class="font-body-sm text-body-sm text-error flex items-center font-medium">
                    <span class="material-symbols-outlined text-[16px] mr-1">info</span>Requires action
                </p>
            </div>
        </div>
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container flex flex-col justify-between">
            <div class="flex justify-between items-start mb-md">
                <div class="p-2 bg-[#d1fae5] text-[#047857] rounded-lg">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">how_to_reg</span>
                </div>
            </div>
            <div>
                <h3 class="font-h1 text-h1 text-on-surface mb-xs">52</h3>
                <div class="w-full bg-surface-variant rounded-full h-1.5 mb-1.5 mt-2">
                    <div class="bg-[#059669] h-1.5 rounded-full" style="width: 89%"></div>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">89% attendance</p>
            </div>
        </div>
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container flex flex-col justify-between">
            <div class="flex justify-between items-start mb-md">
                <div class="p-2 bg-[#fef3c7] text-[#b45309] rounded-lg">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">assignment_late</span>
                </div>
            </div>
            <div>
                <h3 class="font-h1 text-h1 text-on-surface mb-xs">7</h3>
                <p class="font-body-sm text-body-sm text-[#b45309] flex items-center font-medium">
                    <span class="material-symbols-outlined text-[16px] mr-1">warning</span>Needs attention
                </p>
            </div>
        </div>
    </div>

    <!-- Main Layout -->
    <div class="flex flex-col xl:flex-row gap-lg">
        <!-- Quick Actions -->
        <div class="xl:w-1/3 flex flex-col gap-lg">
            <div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container overflow-hidden">
                <div class="p-md border-b border-surface-container">
                    <h3 class="font-h3 text-h3 text-on-surface">Quick Actions</h3>
                </div>
                <div class="p-md flex flex-col gap-sm">
                    <a asp-area="DepartmentHead" asp-controller="Task" asp-action="Index" class="flex items-center w-full px-4 py-3 bg-primary-container text-on-primary rounded-lg hover:bg-primary transition-colors font-label-bold text-label-bold shadow-sm">
                        <span class="material-symbols-outlined mr-3" style="font-variation-settings: 'FILL' 1;">assignment</span>Assign Task
                    </a>
                    <a asp-area="DepartmentHead" asp-controller="Leave" asp-action="Index" class="flex items-center w-full px-4 py-3 bg-surface text-primary-container border border-outline-variant rounded-lg hover:bg-surface-variant transition-colors font-label-bold text-label-bold">
                        <span class="material-symbols-outlined mr-3">event_busy</span>View Team Leave
                    </a>
                    <a asp-area="DepartmentHead" asp-controller="Attendance" asp-action="Index" class="flex items-center w-full px-4 py-3 bg-surface text-primary-container border border-outline-variant rounded-lg hover:bg-surface-variant transition-colors font-label-bold text-label-bold">
                        <span class="material-symbols-outlined mr-3">pending_actions</span>Mark Attendance
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="xl:w-2/3 flex flex-col">
            <div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container flex-1 overflow-hidden flex flex-col">
                <div class="p-md border-b border-surface-container flex justify-between items-center bg-surface-bright">
                    <h3 class="font-h3 text-h3 text-on-surface">Recent Activity</h3>
                    <button class="text-primary-container font-label-bold text-label-bold hover:underline">View All</button>
                </div>
                <ul class="divide-y divide-surface-container">
                    <li class="p-md hover:bg-surface-bright transition-colors flex items-start gap-4">
                        <div class="mt-1 w-10 h-10 rounded-full bg-error-container text-error flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">event_busy</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between items-start mb-1">
                                <p class="font-body-md text-body-md text-on-surface font-medium">Alice Brown requested annual leave</p>
                                <span class="font-body-sm text-body-sm text-on-surface-variant whitespace-nowrap">2 hrs ago</span>
                            </div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">Dates: Oct 28 - Nov 1. Requires approval.</p>
                        </div>
                    </li>
                    <li class="p-md hover:bg-surface-bright transition-colors flex items-start gap-4">
                        <div class="mt-1 w-10 h-10 rounded-full bg-primary-fixed/30 text-primary-container flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">assignment</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between items-start mb-1">
                                <p class="font-body-md text-body-md text-on-surface font-medium">New task assigned to Emily Wong</p>
                                <span class="font-body-sm text-body-sm text-on-surface-variant whitespace-nowrap">4 hrs ago</span>
                            </div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">Task: "Update Q3 Architecture Documentation". Due by Friday.</p>
                        </div>
                    </li>
                    <li class="p-md hover:bg-surface-bright transition-colors flex items-start gap-4">
                        <div class="mt-1 w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">how_to_reg</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between items-start mb-1">
                                <p class="font-body-md text-body-md text-on-surface font-medium">Team attendance marked for Oct 24</p>
                                <span class="font-body-sm text-body-sm text-on-surface-variant whitespace-nowrap">Today, 9:00 AM</span>
                            </div>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">System auto-recorded daily check-ins.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
