@model DeptHeadLeaveIndexViewModel
@{
    ViewBag.Title = "Team Leave Requests - HRMS Portal";
    string TabClass(LeaveRequestStatus? filter) =>
        Model.StatusFilter == filter
            ? "px-6 py-2 text-sm font-semibold rounded-lg bg-white text-primary shadow-sm border border-slate-200"
            : "px-6 py-2 text-sm font-medium rounded-lg text-slate-600 hover:text-slate-900";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div>
        <h2 class="font-h1 text-h1 text-on-surface">Team Leave Requests</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">@Model.DepartmentName team leave requests</p>
    </div>

    <div class="flex bg-slate-200/50 p-1 rounded-xl w-fit">
        <a asp-action="Index" class="@TabClass(null)">All</a>
        <a asp-action="Index" asp-route-status="@((int)LeaveRequestStatus.Pending)" class="@TabClass(LeaveRequestStatus.Pending)">Pending</a>
        <a asp-action="Index" asp-route-status="@((int)LeaveRequestStatus.Approved)" class="@TabClass(LeaveRequestStatus.Approved)">Approved</a>
        <a asp-action="Index" asp-route-status="@((int)LeaveRequestStatus.Rejected)" class="@TabClass(LeaveRequestStatus.Rejected)">Rejected</a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Employee</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Dates</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Reason</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                    @if (Model.Requests.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-on-surface-variant">No leave requests found for your team.</td>
                        </tr>
                    }
                    @foreach (var request in Model.Requests)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center font-label-bold text-xs">@request.EmployeeInitials</div>
                                    <span class="font-medium">@request.EmployeeName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="@LeaveDisplayHelper.GetLeaveTypeBadgeClass(request.LeaveType) px-2.5 py-0.5 rounded-full text-xs font-medium">@LeaveDisplayHelper.GetLeaveTypeLabel(request.LeaveType)</span>
                            </td>
                            <td class="px-6 py-4 text-sm">@LeaveDisplayHelper.FormatDateRange(request.StartDate, request.EndDate)</td>
                            <td class="px-6 py-4 text-sm text-slate-500">@(string.IsNullOrWhiteSpace(request.Reason) ? "—" : request.Reason)</td>
                            <td class="px-6 py-4">
                                <span class="@LeaveDisplayHelper.GetStatusBadgeClass(request.Status) px-2.5 py-0.5 rounded-full text-xs font-medium">@LeaveDisplayHelper.GetStatusLabel(request.Status)</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (request.CanAction)
                                {
                                    <a asp-action="Index" asp-route-status="@((int?)Model.StatusFilter)" asp-route-approveId="@request.Id" class="w-8 h-8 rounded-lg inline-flex items-center justify-center text-green-600 hover:bg-green-50" title="Approve">
                                        <span class="material-symbols-outlined">check_circle</span>
                                    </a>
                                    <a asp-action="Index" asp-route-status="@((int?)Model.StatusFilter)" asp-route-rejectId="@request.Id" class="w-8 h-8 rounded-lg inline-flex items-center justify-center text-red-500 hover:bg-red-50" title="Reject">
                                        <span class="material-symbols-outlined">cancel</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-slate-400 text-sm">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="bg-surface-container-low px-4 py-3 border-t border-outline-variant/30 flex items-center justify-between">
                <div class="font-body-sm text-on-surface-variant">
                    @{
                        var start = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
                        var end = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                    }
                    Showing <span class="font-medium text-on-surface">@start</span> to <span class="font-medium text-on-surface">@end</span> of <span class="font-medium text-on-surface">@Model.TotalCount</span> entries
                </div>
                <div class="flex gap-1">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> { ["page"] = (Model.Page - 1).ToString(), ["status"] = Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString() : null })" class="px-3 py-1 border border-outline-variant/50 rounded text-on-surface hover:bg-surface-container">Previous</a>
                    }
                    <span class="px-3 py-1 bg-primary text-on-primary rounded font-medium">@Model.Page</span>
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-all-route-data="@(new Dictionary<string, string?> { ["page"] = (Model.Page + 1).ToString(), ["status"] = Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString() : null })" class="px-3 py-1 border border-outline-variant/50 rounded text-on-surface hover:bg-surface-container">Next</a>
                    }
                </div>
            </div>
        }
        else if (Model.TotalCount > 0)
        {
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100">
                <p class="text-xs text-slate-500">Showing <span class="font-bold text-slate-900">@Model.TotalCount</span> request@(Model.TotalCount == 1 ? "" : "s")</p>
            </div>
        }
    </div>
</div>

@section Modals {
    @if (Model.ApproveTarget != null)
    {
        <div id="deptApproveModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-sm mx-4 p-xl text-center">
                <div class="w-16 h-16 rounded-full bg-[#d1fae5] text-[#047857] flex items-center justify-center mx-auto mb-lg">
                    <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                </div>
                <h3 class="font-h3 text-h3 text-on-surface mb-sm">Approve Leave?</h3>
                <p class="font-body-md text-on-surface-variant mb-lg">
                    Approve @LeaveDisplayHelper.GetLeaveTypeLabel(Model.ApproveTarget.LeaveType).ToLower() leave for
                    <strong>@Model.ApproveTarget.EmployeeName</strong>
                    (@LeaveDisplayHelper.FormatDateRange(Model.ApproveTarget.StartDate, Model.ApproveTarget.EndDate))?
                </p>
                <form asp-action="Approve" method="post" class="flex justify-center gap-md">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ApproveTarget.Id" />
                    <a asp-action="Index" asp-route-status="@((int?)Model.StatusFilter)" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-[#047857] text-white rounded-lg font-label-bold shadow-sm">Approve</button>
                </form>
            </div>
        </div>
    }

    @if (Model.RejectForm != null)
    {
        <div id="deptRejectModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-md mx-4 p-xl">
                <div class="flex justify-between items-center mb-md">
                    <h3 class="font-h2 text-h2 text-on-surface">Reject Leave</h3>
                    <a asp-action="Index" asp-route-status="@((int?)Model.StatusFilter)" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                </div>
                <p class="font-body-md text-on-surface-variant mb-md">
                    Reject leave for <strong>@Model.RejectForm.EmployeeName</strong>?
                </p>
                <form asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RejectForm.Id" />
                    <partial name="_ModalFormErrors" model="@("RejectForm")" />
                    <div class="mb-lg">
                        <label asp-for="RejectForm.RejectionReason" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <textarea asp-for="RejectForm.RejectionReason" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md h-24 resize-none" placeholder="Reason for rejection..."></textarea>
                        <span asp-validation-for="RejectForm.RejectionReason" class="text-error font-body-sm"></span>
                    </div>
                    <div class="flex justify-end gap-md">
                        <a asp-action="Index" asp-route-status="@((int?)Model.StatusFilter)" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                        <button type="submit" class="px-6 py-2 bg-error text-on-error rounded-lg font-label-bold shadow-sm">Reject</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
