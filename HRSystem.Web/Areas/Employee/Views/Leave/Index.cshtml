@model EmployeeLeaveIndexViewModel
@{
    ViewBag.Title = "My Leave - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-h1 text-h1 text-on-surface">My Leave</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Your leave history and balance</p>
        </div>
        <a asp-action="Index" asp-route-showRequest="true" class="bg-primary-container text-on-primary px-6 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-primary transition-colors shadow-sm">
            <span class="material-symbols-outlined text-sm">add</span>Request Leave
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
        <div class="bg-white p-md rounded-xl shadow-sm border border-slate-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center"><span class="material-symbols-outlined">event_available</span></div>
            <div>
                <p class="text-xs font-label-bold text-slate-500 uppercase">Annual Balance</p>
                <p class="text-xl font-bold text-primary">@Model.AnnualRemaining days</p>
            </div>
        </div>
        <div class="bg-white p-md rounded-xl shadow-sm border border-slate-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-orange-50 text-orange-600 flex items-center justify-center"><span class="material-symbols-outlined">local_hospital</span></div>
            <div>
                <p class="text-xs font-label-bold text-slate-500 uppercase">Sick Balance</p>
                <p class="text-xl font-bold text-primary">@Model.SickRemaining days</p>
            </div>
        </div>
        <div class="bg-white p-md rounded-xl shadow-sm border border-slate-100 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-green-50 text-green-600 flex items-center justify-center"><span class="material-symbols-outlined">check_circle</span></div>
            <div>
                <p class="text-xs font-label-bold text-slate-500 uppercase">Used This Year</p>
                <p class="text-xl font-bold text-primary">@Model.UsedThisYear days</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Dates</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Days</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Reason</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                    @if (Model.Requests.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-on-surface-variant">You have no leave requests yet.</td>
                        </tr>
                    }
                    @foreach (var request in Model.Requests)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <span class="@LeaveDisplayHelper.GetLeaveTypeBadgeClass(request.LeaveType) px-2.5 py-0.5 rounded-full text-xs font-medium">@LeaveDisplayHelper.GetLeaveTypeLabel(request.LeaveType)</span>
                            </td>
                            <td class="px-6 py-4 text-sm">@LeaveDisplayHelper.FormatDateRange(request.StartDate, request.EndDate)</td>
                            <td class="px-6 py-4 text-sm">@request.Days</td>
                            <td class="px-6 py-4 text-sm text-slate-500">@(string.IsNullOrWhiteSpace(request.Reason) ? "—" : request.Reason)</td>
                            <td class="px-6 py-4">
                                <span class="@LeaveDisplayHelper.GetStatusBadgeClass(request.Status) px-2.5 py-0.5 rounded-full text-xs font-medium">@LeaveDisplayHelper.GetStatusLabel(request.Status)</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Modals {
    <div id="requestLeaveModal" class="modal-overlay @(Model.ShowRequestModal ? "active" : "")">
        <div class="modal-content w-full max-w-md mx-4 p-xl">
            <div class="flex justify-between items-center mb-lg">
                <h3 class="font-h2 text-h2 text-on-surface">Request Leave</h3>
                <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
            </div>
            <div class="bg-[#fef3c7] border border-[#f59e0b]/30 rounded-lg p-md flex gap-sm items-start mb-md">
                <span class="material-symbols-outlined text-[#b45309] mt-0.5">info</span>
                <p class="font-body-sm text-body-sm text-[#92400e]">
                    You have <strong>@Model.AnnualRemaining annual</strong> and <strong>@Model.SickRemaining sick</strong> leave days remaining.
                </p>
            </div>
            <form asp-action="SubmitRequest" method="post" class="space-y-md">
                @Html.AntiForgeryToken()
                <partial name="_ModalFormErrors" model="@("RequestForm")" />
                <div>
                    <label asp-for="RequestForm.LeaveType" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                    <select asp-for="RequestForm.LeaveType" asp-items="Html.GetEnumSelectList<HRSystem.Common.Enums.LeaveType>()" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md appearance-none"></select>
                    <span asp-validation-for="RequestForm.LeaveType" class="text-error font-body-sm"></span>
                </div>
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label asp-for="RequestForm.StartDate" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="RequestForm.StartDate" type="date" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                        <span asp-validation-for="RequestForm.StartDate" class="text-error font-body-sm"></span>
                    </div>
                    <div>
                        <label asp-for="RequestForm.EndDate" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <input asp-for="RequestForm.EndDate" type="date" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md" />
                        <span asp-validation-for="RequestForm.EndDate" class="text-error font-body-sm"></span>
                    </div>
                </div>
                <div>
                    <label asp-for="RequestForm.Reason" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                    <textarea asp-for="RequestForm.Reason" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md h-20 resize-none" placeholder="Brief reason..."></textarea>
                    <span asp-validation-for="RequestForm.Reason" class="text-error font-body-sm"></span>
                </div>
                <div class="flex justify-end gap-md pt-md border-t border-outline-variant/30">
                    <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
}
