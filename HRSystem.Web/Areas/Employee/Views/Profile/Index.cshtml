@model HRSystem.Web.ViewModels.Profile.EmployeeProfileViewModel
@{
    ViewBag.Title = "My Profile - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <!-- Header / Banner -->
    <div class="bg-gradient-to-r from-[#1F4E79] to-[#2a6496] rounded-2xl p-6 lg:p-8 text-white shadow-md relative overflow-hidden">
        <div class="absolute right-0 top-0 w-96 h-96 bg-white/5 rounded-full blur-2xl -mr-20 -mt-20"></div>
        <div class="relative z-10 flex flex-col sm:flex-row items-center sm:items-start gap-6">
            <!-- Avatar -->
            <div class="w-24 h-24 rounded-2xl bg-white text-[#1F4E79] flex items-center justify-center font-black text-3xl shadow-lg shrink-0 border-4 border-white/20">
                @Model.Initials
            </div>
            
            <div class="flex-1 text-center sm:text-left space-y-2">
                <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                    <h1 class="text-2xl lg:text-3xl font-bold tracking-tight">@Model.FullName</h1>
                    <div>
                        @{
                            var roleBadgeClass = Model.Role switch
                            {
                                HRSystem.Common.Constants.RoleNames.HR => "bg-sky-400/20 text-sky-200 border-sky-400/30",
                                HRSystem.Common.Constants.RoleNames.DepartmentHead => "bg-amber-400/20 text-amber-200 border-amber-400/30",
                                _ => "bg-white/15 text-slate-100 border-white/20"
                            };
                        }
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border @roleBadgeClass">
                            @Model.Role
                        </span>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-center sm:justify-start gap-4 text-sm text-sky-100/80">
                    <span class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-base text-sky-300">mail</span>
                        @Model.Email
                    </span>
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <span class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-base text-sky-300">phone</span>
                            @Model.PhoneNumber
                        </span>
                    }
                    <span class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-base text-sky-300">domain</span>
                        @Model.DepartmentName
                    </span>
                    <span class="flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-base text-sky-300">calendar_month</span>
                        Joined @Model.HireDate.ToString("MMM dd, yyyy") (@Model.Tenure)
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column: Personal & Contact Info -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Contact & Personal Details Card -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 space-y-6">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <h3 class="font-h2 text-lg font-bold text-on-surface">Personal & Contact Information</h3>
                        <p class="font-body-sm text-xs text-on-surface-variant">Update your reachable contact information</p>
                    </div>
                    <span class="material-symbols-outlined text-slate-400">person</span>
                </div>

                <form asp-action="UpdateContact" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-error text-sm"></div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-label-bold text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">First Name</label>
                            <input type="text" value="@Model.FirstName" disabled class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-500 cursor-not-allowed" />
                        </div>
                        <div>
                            <label class="block font-label-bold text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Last Name</label>
                            <input type="text" value="@Model.LastName" disabled class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-500 cursor-not-allowed" />
                        </div>
                    </div>

                    <div>
                        <label class="block font-label-bold text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Email Address</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">mail</span>
                            <input type="email" value="@Model.Email" disabled class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-sm text-slate-500 cursor-not-allowed" />
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">Managed by HR administrator</p>
                    </div>

                    <div>
                        <label asp-for="UpdateContactForm.PhoneNumber" class="block font-label-bold text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1"></label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm">phone</span>
                            <input asp-for="UpdateContactForm.PhoneNumber" type="tel" placeholder="e.g. +1 555-0199" class="w-full bg-white border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-sm text-slate-800 focus:border-[#1F4E79] focus:ring-1 focus:ring-[#1F4E79]" />
                        </div>
                        <span asp-validation-for="UpdateContactForm.PhoneNumber" class="text-error text-xs"></span>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="bg-[#1F4E79] text-white px-5 py-2 rounded-lg font-label-bold text-sm hover:bg-[#2a6496] transition-colors shadow-sm flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">save</span>Save Changes
                        </button>
                    </div>
                </form>
            </div>

            <!-- Employment Details Card -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 space-y-6">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <h3 class="font-h2 text-lg font-bold text-on-surface">Employment Overview</h3>
                        <p class="font-body-sm text-xs text-on-surface-variant">Your role and organizational placement</p>
                    </div>
                    <span class="material-symbols-outlined text-slate-400">badge</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-100 space-y-1">
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Department</p>
                        <p class="text-base font-bold text-slate-800">@Model.DepartmentName</p>
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-100 space-y-1">
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Manager</p>
                        <p class="text-base font-bold text-slate-800">@Model.DepartmentManagerName</p>
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-100 space-y-1">
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Hire Date</p>
                        <p class="text-base font-bold text-slate-800">@Model.HireDate.ToString("MMMM dd, yyyy")</p>
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-100 space-y-1">
                        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Base Salary</p>
                        <p class="text-base font-bold text-slate-800">@Model.Salary.ToString("C2")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Leave Balance & Security -->
        <div class="space-y-6">
            <!-- Leave Quotas Card -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 space-y-5">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <h3 class="font-h2 text-lg font-bold text-on-surface">Leave Balances</h3>
                        <p class="font-body-sm text-xs text-on-surface-variant">@DateTime.UtcNow.Year balance status</p>
                    </div>
                    <span class="material-symbols-outlined text-slate-400">event_busy</span>
                </div>

                <!-- Annual Leave -->
                <div class="space-y-2 p-4 bg-[#f0fdf4] rounded-xl border border-[#dcfce7]">
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-bold text-[#166534]">Annual Leave</span>
                        <span class="text-xs font-bold text-[#166534]">@Model.AnnualLeaveRemaining of @Model.AnnualLeaveTotal days left</span>
                    </div>
                    <div class="w-full bg-[#dcfce7] rounded-full h-2">
                        @{
                            var annualPercent = Model.AnnualLeaveTotal > 0 ? (int)((double)Model.AnnualLeaveUsed / Model.AnnualLeaveTotal * 100) : 0;
                        }
                        <div class="bg-[#16a34a] h-2 rounded-full" style="width: @(100 - annualPercent)%"></div>
                    </div>
                    <div class="flex justify-between text-[11px] text-[#166534]/80 pt-1">
                        <span>Used: @Model.AnnualLeaveUsed d</span>
                        <span>Remaining: @Model.AnnualLeaveRemaining d</span>
                    </div>
                </div>

                <!-- Sick Leave -->
                <div class="space-y-2 p-4 bg-[#fefce8] rounded-xl border border-[#fef9c3]">
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-bold text-[#854d0e]">Sick Leave</span>
                        <span class="text-xs font-bold text-[#854d0e]">@Model.SickLeaveRemaining of @Model.SickLeaveTotal days left</span>
                    </div>
                    <div class="w-full bg-[#fef9c3] rounded-full h-2">
                        @{
                            var sickPercent = Model.SickLeaveTotal > 0 ? (int)((double)Model.SickLeaveUsed / Model.SickLeaveTotal * 100) : 0;
                        }
                        <div class="bg-[#ca8a04] h-2 rounded-full" style="width: @(100 - sickPercent)%"></div>
                    </div>
                    <div class="flex justify-between text-[11px] text-[#854d0e]/80 pt-1">
                        <span>Used: @Model.SickLeaveUsed d</span>
                        <span>Remaining: @Model.SickLeaveRemaining d</span>
                    </div>
                </div>

                <a asp-area="Employee" asp-controller="Leave" asp-action="Index" class="block text-center text-xs font-semibold text-[#1F4E79] hover:underline pt-2">
                    Request Leave or View History &rarr;
                </a>
            </div>

            <!-- Security & Quick Actions -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 space-y-4">
                <div class="flex justify-between items-center border-b border-slate-100 pb-4">
                    <div>
                        <h3 class="font-h2 text-lg font-bold text-on-surface">Account Security</h3>
                        <p class="font-body-sm text-xs text-on-surface-variant">Credentials & authentication</p>
                    </div>
                    <span class="material-symbols-outlined text-slate-400">shield</span>
                </div>

                <div class="space-y-3">
                    <a asp-area="" asp-controller="Account" asp-action="ChangePassword" class="flex items-center justify-between p-3.5 bg-slate-50 hover:bg-slate-100 rounded-xl transition-colors border border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-slate-500">lock_reset</span>
                            <div>
                                <p class="text-sm font-semibold text-slate-800">Change Password</p>
                                <p class="text-xs text-slate-500">Update your account password</p>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-slate-400 text-sm">arrow_forward_ios</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
