@model EmployeeAttendanceIndexViewModel
@{
    ViewBag.Title = "My Attendance - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex justify-between items-end">
        <div>
            <h2 class="font-h1 text-h1 text-on-surface">My Attendance</h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Your attendance history</p>
        </div>
        <div class="flex items-center gap-2">
            @if (Model.CanCheckIn)
            {
                <a asp-action="Index" asp-route-showCheckIn="true" class="bg-[#047857] text-white px-6 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-[#059669] transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-sm">login</span>Check In
                </a>
            }
            else if (Model.CanCheckOut)
            {
                <a asp-action="Index" asp-route-showCheckOut="true" class="bg-[#b45309] text-white px-6 py-2.5 rounded-lg font-label-bold flex items-center gap-2 hover:bg-[#d97706] transition-colors shadow-sm">
                    <span class="material-symbols-outlined text-sm">logout</span>Check Out
                </a>
            }
            else
            {
                <span class="text-slate-400 text-sm">Already checked out</span>
            }
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Check In</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Check Out</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Hours</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                    @if (Model.Records.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-on-surface-variant">No attendance records found.</td>
                        </tr>
                    }
                    @foreach (var row in Model.Records)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-medium">@AttendanceDisplayHelper.FormatDate(row.Date)</td>
                            <td class="px-6 py-4">@AttendanceDisplayHelper.FormatTime(row.CheckInTime)</td>
                            <td class="px-6 py-4">@AttendanceDisplayHelper.FormatTime(row.CheckOutTime)</td>
                            <td class="px-6 py-4 text-slate-600">@row.DurationLabel</td>
                            <td class="px-6 py-4">
                                <span class="@AttendanceDisplayHelper.GetStatusBadgeClass(row.StatusLabel) px-2.5 py-0.5 rounded-full text-xs font-medium">@row.StatusLabel</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@section Modals {
    @if (Model.ShowCheckInModal)
    {
        <div id="checkInModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-sm mx-4 p-xl text-center">
                <div class="w-16 h-16 rounded-full bg-[#d1fae5] text-[#047857] flex items-center justify-center mx-auto mb-lg">
                    <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 1;">login</span>
                </div>
                <h3 class="font-h3 text-h3 text-on-surface mb-sm">Check In?</h3>
                <p class="font-body-md text-on-surface-variant mb-lg">Record your check-in time as <strong>now</strong>?</p>
                <form asp-action="CheckIn" method="post" class="flex justify-center gap-md">
                    @Html.AntiForgeryToken()
                    <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-[#047857] text-white rounded-lg font-label-bold shadow-sm">Check In</button>
                </form>
            </div>
        </div>
    }

    @if (Model.ShowCheckOutModal)
    {
        <div id="checkOutModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-sm mx-4 p-xl text-center">
                <div class="w-16 h-16 rounded-full bg-[#fef3c7] text-[#b45309] flex items-center justify-center mx-auto mb-lg">
                    <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 1;">logout</span>
                </div>
                <h3 class="font-h3 text-h3 text-on-surface mb-sm">Check Out?</h3>
                <p class="font-body-md text-on-surface-variant mb-lg">Record your check-out time as <strong>now</strong>?</p>
                <form asp-action="CheckOut" method="post" class="flex justify-center gap-md">
                    @Html.AntiForgeryToken()
                    <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-[#b45309] text-white rounded-lg font-label-bold shadow-sm">Check Out</button>
                </form>
            </div>
        </div>
    }
}
