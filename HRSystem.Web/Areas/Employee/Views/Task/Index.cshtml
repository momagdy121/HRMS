@model EmployeeTaskIndexViewModel
@{
    ViewBag.Title = "My Tasks - HRMS Portal";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div>
        <h2 class="font-h1 text-h1 text-on-surface">My Tasks</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">Your assigned tasks</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Task</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Assigned By</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Due Date</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 font-label-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-body-md text-on-surface">
                    @if (Model.Tasks.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-on-surface-variant">You have no assigned tasks.</td>
                        </tr>
                    }
                    @foreach (var task in Model.Tasks)
                    {
                        <tr class="striped-row hover:bg-slate-50/80 transition-colors">
                            <td class="px-6 py-4">
                                <p class="font-medium">@task.Title</p>
                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <p class="text-body-sm text-slate-500">@task.Description</p>
                                }
                                @if (task.Status == HRSystem.Common.Enums.TaskStatus.Completed && !string.IsNullOrWhiteSpace(task.CompletionNotes))
                                {
                                    <p class="text-body-sm text-green-700 mt-1">
                                        <span class="font-medium">Completion:</span> @task.CompletionNotes
                                    </p>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold text-xs">@task.PersonInitials</div>
                                    <span>@task.PersonName</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="@(task.IsOverdue ? "text-error font-medium" : "")">@task.DueDate.Value.ToString("MMM d, yyyy")</span>
                                }
                                else
                                {
                                    <span class="text-slate-400">—</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <span class="@TaskDisplayHelper.GetStatusBadgeClass(task.Status) px-2.5 py-0.5 rounded-full text-xs font-medium">@TaskDisplayHelper.GetStatusLabel(task.Status)</span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (task.CanUpdateStatus)
                                {
                                    <a asp-action="Index" asp-route-updateId="@task.Id" class="text-primary-container hover:underline text-sm font-medium">Update Status</a>
                                }
                                else
                                {
                                    <span class="text-slate-400 text-sm">Done</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>

@if (Model.UpdateStatusForm != null)
{
    @section Modals {
        <div id="updateStatusModal" class="modal-overlay active">
            <div class="modal-content w-full max-w-md mx-4 p-xl">
                <div class="flex justify-between items-center mb-lg">
                    <h3 class="font-h2 text-h2 text-on-surface">Update Status</h3>
                    <a asp-action="Index" class="p-1 text-on-surface-variant hover:text-on-surface"><span class="material-symbols-outlined">close</span></a>
                </div>
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UpdateStatusForm!.Id" />
                    <partial name="_ModalFormErrors" model="@("UpdateStatusForm")" />
                    <p class="font-body-md text-on-surface-variant mb-md">
                        Task: <strong>@Model.UpdateStatusForm.TaskTitle</strong>
                    </p>
                    <p class="font-body-sm text-on-surface-variant mb-md">
                        Current: @TaskDisplayHelper.GetStatusLabel(Model.UpdateStatusForm.CurrentStatus)
                    </p>
                    <div class="mb-lg">
                        <label asp-for="UpdateStatusForm.Status" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                        <select asp-for="UpdateStatusForm.Status" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md appearance-none">
                            @foreach (var status in Model.UpdateStatusForm.AllowedNextStatuses)
                            {
                                <option value="@((int)status)">@TaskDisplayHelper.GetStatusLabel(status)</option>
                            }
                        </select>
                        <span asp-validation-for="UpdateStatusForm.Status" class="text-error font-body-sm"></span>
                    </div>
                    @if (Model.UpdateStatusForm.CurrentStatus == HRSystem.Common.Enums.TaskStatus.InProgress)
                    {
                        <div class="mb-lg">
                            <label asp-for="UpdateStatusForm.CompletionNotes" class="block font-label-bold text-on-surface-variant mb-xs"></label>
                            <textarea asp-for="UpdateStatusForm.CompletionNotes" rows="4" class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-md py-2 font-body-md resize-none" placeholder="Add the link, token, or other details your manager requested..."></textarea>
                            <span asp-validation-for="UpdateStatusForm.CompletionNotes" class="text-error font-body-sm"></span>
                        </div>
                    }
                    <div class="flex justify-end gap-md">
                        <a asp-action="Index" class="px-6 py-2 border border-outline-variant rounded-lg text-on-surface-variant font-label-bold">Cancel</a>
                        <button type="submit" class="px-6 py-2 bg-primary-container text-on-primary rounded-lg font-label-bold shadow-sm">Update</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
