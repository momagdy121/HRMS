@model HRSystem.Web.ViewModels.Dashboard.EmployeeDashboardViewModel
@{
    ViewBag.Title = "My Dashboard - HRMS Portal";
}

<div class="max-w-7xl mx-auto">
    <div class="mb-lg">
        <h1 class="font-h1 text-h1 text-primary-container mb-xs">Welcome back, @Model.FirstName!</h1>
        <p class="font-body-lg text-body-lg text-secondary">Here's your personal dashboard overview</p>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md mb-lg">
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container">
            <div class="flex justify-between items-start mb-md">
                <div class="p-2 bg-primary-fixed/20 rounded-lg text-primary-container">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">assignment</span>
                </div>
                @if (Model.TasksDueSoon > 0)
                {
                    <span class="text-[#b45309] bg-[#fef3c7] text-xs font-bold px-2 py-0.5 rounded-full">@Model.TasksDueSoon due soon</span>
                }
            </div>
            <h3 class="font-h1 text-h1 text-on-surface mb-xs">@Model.ActiveTasks</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Active Tasks</p>
        </div>
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container">
            <div class="flex justify-between items-start mb-md">
                <div class="p-2 bg-[#d1fae5] text-[#047857] rounded-lg">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">event_available</span>
                </div>
            </div>
            <h3 class="font-h1 text-h1 text-on-surface mb-xs">@Model.LeaveBalanceDays</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Leave Balance (days)</p>
        </div>
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container">
            <div class="flex justify-between items-start mb-md">
                <div class="p-2 bg-[#fef3c7] text-[#b45309] rounded-lg">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">pending_actions</span>
                </div>
            </div>
            <h3 class="font-h1 text-h1 text-on-surface mb-xs">@Model.DaysPresentThisMonth</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Days Present (this month)</p>
        </div>
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container">
            <div class="flex justify-between items-start mb-md">
                <div class="p-2 bg-primary-fixed/20 rounded-lg text-primary-container">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">payments</span>
                </div>
            </div>
            <h3 class="font-h1 text-h1 text-on-surface mb-xs">@Model.LastNetSalary.ToString("C0")</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">Last Net Salary</p>
        </div>
    </div>

    <!-- Main Layout -->
    <div class="flex flex-col xl:flex-row gap-lg">
        <!-- Quick Actions -->
        <div class="xl:w-1/3 flex flex-col gap-lg">
            <div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container overflow-hidden">
                <div class="p-md border-b border-surface-container">
                    <h3 class="font-h3 text-h3 text-on-surface">Quick Actions</h3>
                </div>
                <div class="p-md flex flex-col gap-sm">
                    <a asp-area="Employee" asp-controller="Leave" asp-action="Index" class="flex items-center w-full px-4 py-3 bg-primary-container text-on-primary rounded-lg hover:bg-primary transition-colors font-label-bold text-label-bold shadow-sm">
                        <span class="material-symbols-outlined mr-3" style="font-variation-settings: 'FILL' 1;">add_circle</span>Request Leave
                    </a>
                    <a asp-area="Employee" asp-controller="Task" asp-action="Index" class="flex items-center w-full px-4 py-3 bg-surface text-primary-container border border-outline-variant rounded-lg hover:bg-surface-variant transition-colors font-label-bold text-label-bold">
                        <span class="material-symbols-outlined mr-3">assignment</span>View My Tasks
                    </a>
                    <a asp-area="Employee" asp-controller="Payroll" asp-action="Index" class="flex items-center w-full px-4 py-3 bg-surface text-primary-container border border-outline-variant rounded-lg hover:bg-surface-variant transition-colors font-label-bold text-label-bold">
                        <span class="material-symbols-outlined mr-3">payments</span>View Payslips
                    </a>
                </div>
            </div>

            <!-- Recent Payslips -->
            <div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container overflow-hidden">
                <div class="p-md border-b border-surface-container flex justify-between items-center">
                    <h3 class="font-h3 text-h3 text-on-surface">Recent Payslips</h3>
                    <a asp-area="Employee" asp-controller="Payroll" asp-action="Index" class="text-primary-container font-label-bold text-xs hover:underline">View All</a>
                </div>
                @if (Model.RecentPayslips.Any())
                {
                    <ul class="divide-y divide-surface-container">
                        @foreach (var payslip in Model.RecentPayslips)
                        {
                            <li class="p-md flex justify-between items-center hover:bg-surface-bright transition-colors">
                                <div>
                                    <p class="font-label-bold text-on-surface">@payslip.Period</p>
                                    <p class="text-body-sm text-on-surface-variant">@payslip.PaymentDate</p>
                                </div>
                                <span class="font-h3 text-h3 text-[#047857]">@payslip.NetSalary.ToString("C0")</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-6 text-center text-on-surface-variant">
                        <p class="font-body-sm">No payslips generated yet.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Team Presence -->
        <div class="xl:w-2/3">
            <div class="bg-surface-container-lowest rounded-xl shadow-[0_2px_4px_rgba(0,0,0,0.05)] border border-surface-container overflow-hidden">
                <div class="p-md border-b border-surface-container">
                    <h3 class="font-h3 text-h3 text-on-surface">Team Members — @Model.DepartmentName</h3>
                </div>
                @if (Model.TeamMembers.Any())
                {
                    <ul class="divide-y divide-surface-container">
                        @foreach (var member in Model.TeamMembers)
                        {
                            <li class="p-md flex items-center justify-between hover:bg-surface-bright transition-colors">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center font-label-bold">
                                        @member.Initials
                                    </div>
                                    <div>
                                        <p class="font-label-bold text-on-surface">@member.Name</p>
                                        <p class="text-body-sm text-on-surface-variant">@member.Role</p>
                                    </div>
                                </div>
                                @if (member.IsPresentToday)
                                {
                                    <span class="bg-green-50 text-green-700 px-2.5 py-0.5 rounded-full text-xs font-medium flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>Present
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-slate-100 text-slate-500 px-2.5 py-0.5 rounded-full text-xs font-medium flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 bg-slate-400 rounded-full"></span>Offline
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-8 text-center text-on-surface-variant">
                        <p class="font-body-sm">No other team members found.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
