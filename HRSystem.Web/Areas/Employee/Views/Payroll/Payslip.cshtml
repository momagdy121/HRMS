@model HRSystem.Web.ViewModels.Payroll.PayslipViewModel
@{
    Layout = null;
    var periodLabel = HRSystem.Web.Helpers.PayrollDisplayHelper.GetPeriodLabel(Model.Month, Model.Year);
    var statusLabel = HRSystem.Web.Helpers.PayrollDisplayHelper.GetStatusLabel(Model.Status);
    var bonuses = Model.Items.Where(i => i.ItemType == HRSystem.Common.Enums.ItemType.Bonus).ToList();
    var deductions = Model.Items.Where(i => i.ItemType == HRSystem.Common.Enums.ItemType.Deduction).ToList();
    var grossEarnings = Model.BaseSalary + Model.TotalBonus;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payslip - @Model.EmployeeName - @periodLabel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }

        @@media print {
            body {
                background-color: #ffffff !important;
                color: #000000 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print {
                display: none !important;
            }
            .print-container {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
            }
            .page-break {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body class="min-h-screen py-8 px-4 sm:px-6">

    <!-- Top Action Bar (Screen Only) -->
    <div class="max-w-4xl mx-auto mb-6 flex items-center justify-between no-print">
        <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors bg-white px-4 py-2 rounded-lg border border-slate-200 shadow-sm">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>
        <div class="flex items-center gap-3">
            <button onclick="window.print()" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg shadow-sm transition-all shadow-blue-500/20 hover:shadow-md">
                <span class="material-symbols-outlined text-sm">print</span>
                Print / Save PDF
            </button>
        </div>
    </div>

    <!-- Official Payslip Document -->
    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-xl border border-slate-200 p-8 sm:p-12 print-container page-break">
        
        <!-- Corporate Letterhead -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pb-8 border-b-2 border-slate-900 gap-6">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold text-2xl shadow-md">
                    H
                </div>
                <div>
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight">HRMS ENTERPRISE</h1>
                    <p class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Human Resource Management System</p>
                    <p class="text-xs text-slate-400 mt-0.5">100 Innovation Way, Tech Park, Suite 400</p>
                </div>
            </div>
            <div class="text-left sm:text-right">
                <span class="inline-block px-3 py-1 text-xs font-bold uppercase rounded-md tracking-wider bg-slate-100 text-slate-800 border border-slate-200">
                    Official Payslip
                </span>
                <p class="text-lg font-bold text-slate-900 mt-2">@periodLabel</p>
                <p class="text-xs text-slate-500">Ref: #PAY-@Model.Id.ToString("D6")</p>
            </div>
        </div>

        <!-- Employee & Pay Metadata Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 py-8 border-b border-slate-200 text-sm">
            <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Employee Name</p>
                <p class="font-bold text-slate-900">@Model.EmployeeName</p>
                <p class="text-xs text-slate-500">@Model.EmployeeCode</p>
            </div>
            <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Department & Role</p>
                <p class="font-bold text-slate-900">@Model.DepartmentName</p>
                <p class="text-xs text-slate-500">@Model.JobTitle</p>
            </div>
            <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Payment Status</p>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold @(Model.Status == HRSystem.Common.Enums.PayrollStatus.Paid ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : Model.Status == HRSystem.Common.Enums.PayrollStatus.Approved ? "bg-blue-50 text-blue-700 border border-blue-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                    <span class="w-1.5 h-1.5 rounded-full @(Model.Status == HRSystem.Common.Enums.PayrollStatus.Paid ? "bg-emerald-500" : Model.Status == HRSystem.Common.Enums.PayrollStatus.Approved ? "bg-blue-500" : "bg-amber-500")"></span>
                    @statusLabel
                </span>
                <p class="text-xs text-slate-400 mt-1">Processed: @(Model.ProcessedAt?.ToString("MMM dd, yyyy") ?? "—")</p>
            </div>
            <div>
                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Email & Join Date</p>
                <p class="font-medium text-slate-700 truncate">@Model.Email</p>
                <p class="text-xs text-slate-400">Joined: @(Model.JoinDate.HasValue ? Model.JoinDate.Value.ToString("MMM yyyy") : "—")</p>
            </div>
        </div>

        <!-- Financial Breakdown Tables (Two Column Side-by-Side) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 py-8 border-b border-slate-200">
            
            <!-- Earnings Section -->
            <div class="space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        Earnings
                    </h2>
                    <span class="text-xs text-slate-400 font-semibold uppercase">Amount</span>
                </div>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between items-center text-slate-700">
                        <span>Basic Salary</span>
                        <span class="font-semibold text-slate-900">@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(Model.BaseSalary)</span>
                    </div>

                    @foreach (var bonus in bonuses)
                    {
                        <div class="flex justify-between items-center text-slate-700">
                            <span class="text-xs text-slate-600">@bonus.Description</span>
                            <span class="font-semibold text-emerald-600">+@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(bonus.Amount)</span>
                        </div>
                    }

                    @if (bonuses.Count == 0)
                    {
                        <div class="flex justify-between items-center text-slate-400 text-xs italic">
                            <span>Additional Allowances</span>
                            <span>$0.00</span>
                        </div>
                    }
                </div>

                <div class="pt-4 border-t border-slate-100 flex justify-between items-center font-bold text-sm bg-slate-50 p-3 rounded-lg">
                    <span class="text-slate-800">Total Gross Earnings</span>
                    <span class="text-emerald-700 font-extrabold text-base">@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(grossEarnings)</span>
                </div>
            </div>

            <!-- Deductions Section -->
            <div class="space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                    <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                        Deductions
                    </h2>
                    <span class="text-xs text-slate-400 font-semibold uppercase">Amount</span>
                </div>
                <div class="space-y-3 text-sm">
                    @foreach (var deduction in deductions)
                    {
                        <div class="flex justify-between items-center text-slate-700">
                            <span class="text-xs text-slate-600">@deduction.Description</span>
                            <span class="font-semibold text-rose-600">-@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(deduction.Amount)</span>
                        </div>
                    }

                    @if (deductions.Count == 0)
                    {
                        <div class="flex justify-between items-center text-slate-400 text-xs italic">
                            <span>Standard Deductions</span>
                            <span>$0.00</span>
                        </div>
                    }
                </div>

                <div class="pt-4 border-t border-slate-100 flex justify-between items-center font-bold text-sm bg-slate-50 p-3 rounded-lg">
                    <span class="text-slate-800">Total Deductions</span>
                    <span class="text-rose-700 font-extrabold text-base">@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(Model.TotalDeduction)</span>
                </div>
            </div>
        </div>

        <!-- Net Payable Amount Highlight Banner -->
        <div class="my-8 p-6 bg-slate-900 text-white rounded-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <p class="text-xs uppercase font-bold tracking-widest text-slate-400">Total Net Payable</p>
                <p class="text-xs text-slate-300 mt-1">Gross Earnings (@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(grossEarnings)) - Total Deductions (@HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(Model.TotalDeduction))</p>
            </div>
            <div class="text-left sm:text-right">
                <p class="text-3xl font-black text-white tracking-tight">
                    @HRSystem.Web.Helpers.PayrollDisplayHelper.FormatCurrency(Model.NetSalary)
                </p>
            </div>
        </div>

        <!-- Signatures & Disclaimer -->
        <div class="pt-10 grid grid-cols-2 gap-12 text-center text-xs text-slate-500">
            <div>
                <div class="border-b border-slate-300 pb-16 mb-2"></div>
                <p class="font-bold text-slate-800">Authorized HR Signatory</p>
                <p class="text-slate-400">Payroll & Finance Department</p>
            </div>
            <div>
                <div class="border-b border-slate-300 pb-16 mb-2"></div>
                <p class="font-bold text-slate-800">Employee Signature</p>
                <p class="text-slate-400">Acknowledgment of Receipt</p>
            </div>
        </div>

        <div class="mt-12 pt-6 border-t border-slate-100 text-center text-[11px] text-slate-400">
            <p>This is a computer-generated official document. If you have any inquiries regarding this payslip, please contact HR Finance.</p>
            <p class="mt-1">&copy; @DateTime.UtcNow.Year HRMS Enterprise Solutions. All rights reserved.</p>
        </div>
    </div>

</body>
</html>
